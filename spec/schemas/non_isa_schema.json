{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "v0.1",
  "title": "Schema for Non-ISA specification definitions",
  "type": "object",
  "required": ["$schema", "kind", "name", "description", "sections"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "const": "non_isa_schema.json#"
    },
    "kind": {
      "type": "string",
      "const": "non-isa specification"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "Name of the non-ISA specification"
    },
    "long_name": {
      "type": "string",
      "description": "Human-readable name for the specification"
    },
    "version": {
      "$ref": "schema_defs.json#/$defs/semantic_version",
      "description": "Version of this non-ISA specification"
    },
    "ratification_date": {
      "$ref": "schema_defs.json#/$defs/date",
      "description": "Date this specification was ratified or released"
    },
    "description": {
      "$ref": "schema_defs.json#/$defs/spec_text",
      "description": "AsciiDoc description of the specification"
    },
    "sections": {
      "type": "array",
      "description": "Organized sections of the specification",
      "items": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Section title"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "default": 3,
            "description": "AsciiDoc heading level (1-6)"
          },
          "content": {
            "$ref": "schema_defs.json#/$defs/spec_text",
            "description": "AsciiDoc content for this section"
          },
          "when()": {
            "type": "string",
            "description": "IDL boolean expression. When true, this section applies"
          }
        },
        "additionalProperties": false
      }
    },
    "register_blocks": {
      "type": "array",
      "description": "Structured register-block definitions for a non-ISA specification whose base address is platform-defined.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "alignment",
          "endianness",
          "registers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "$ref": "schema_defs.json#/$defs/spec_text"
          },
          "alignment": {
            "type": "integer",
            "minimum": 1
          },
          "endianness": {
            "enum": ["little", "big"]
          },
          "registers": {
            "type": "array",
            "items": { "$ref": "#/$defs/non_isa_register" }
          },
          "operation_layouts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "opcode", "description", "registers"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "opcode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "description": {
                  "$ref": "schema_defs.json#/$defs/spec_text"
                },
                "registers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "fields"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "fields": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/non_isa_register_field" }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "description": "External references and links",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "authors": {
      "type": "array",
      "description": "Authors of this specification",
      "items": {
        "$ref": "schema_defs.json#/$defs/author"
      }
    },
    "license": {
      "$ref": "schema_defs.json#/$defs/license",
      "description": "License under which this specification is released"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_isa_register_field": {
      "type": "object",
      "required": ["name", "location", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "location": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+-[0-9]+$" }
          ]
        },
        "access": {
          "enum": ["RO", "RW", "WARL"]
        },
        "description": {
          "$ref": "schema_defs.json#/$defs/spec_text"
        }
      },
      "additionalProperties": false
    },
    "non_isa_register": {
      "type": "object",
      "required": ["name", "offset", "length", "access", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "enum": [32, 64]
        },
        "access": {
          "enum": ["RO", "RW"]
        },
        "description": {
          "$ref": "schema_defs.json#/$defs/spec_text"
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_isa_register_field" }
        }
      },
      "additionalProperties": false
    }
  }
}

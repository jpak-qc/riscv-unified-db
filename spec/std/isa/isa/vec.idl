%version: 1.0

# - test suite?
# - Vector params (there will be many)
# - Vector state
# - Order (might be dictated somewhat by test suite)
#   - vset*
#   - integer arith (vadd/vsub/vrsub(.vv,.vx,.vi), compare, min, max)
#   - integer widening arith ()

# the vector register file is populated by the symtab from V.yaml

enum VectorLmulType {
  Divide
  Multiply
}

function check_v_state_enabled {
  arguments
    Bits<INSTR_ENC_SIZE> encoding
  description {
    Checks whether vector state is enabled for the current privilege mode.
  }
  body {
    if (MUTABLE_MISA_V && CSR[misa].V == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }

    if (CSR[mstatus].VS == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }
  }
}

function check_v_ok {
  arguments
    Bits<INSTR_ENC_SIZE> encoding
  description {
    Checks whether a vector instruction may execute with the current vector
    configuration.
  }
  body {
    check_v_state_enabled(encoding);

    if (CSR[vtype].VILL == 1'b1) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }
  }
}

function mark_v_state_dirty {
  description {
    Potentially updates `mstatus.VS` to the Dirty (3) state, depending on
    configuration settings.
  }
  body {
    if (HW_MSTATUS_VS_DIRTY_UPDATE == "precise") {
      CSR[mstatus].VS = 3;
    } else if (HW_MSTATUS_VS_DIRTY_UPDATE == "imprecise") {
      unpredictable("The hart may or may not update mstatus.VS now");
    }
  }
}

struct VectorState {
  Bits<7> sew;
  Bits<3> log2_sew;
  VectorLmulType lmul_type;
  Bits<2> log2_lmul;
}

function vector_state {
  returns VectorState
  description {
    Get the current vector state from CSRs
  }
  body {
    VectorState state;

    state.log2_sew = 3 + CSR[vtype].VSEW;
    state.sew = 7'b1 << state.log2_sew;

    Bits<3> vlmul = CSR[vtype].VLMUL;
    state.lmul_type = CSR[vtype].VLMUL[2] == 1'b1 ? VectorLmulType::Divide : VectorLmulType::Multiply;
    state.log2_lmul = CSR[vtype].VLMUL[1:0];
    if (vlmul == 3'b101) {
      state.log2_lmul = 3;
    } else if (vlmul == 3'b110) {
      state.log2_lmul = 2;
    } else if (vlmul == 3'b111) {
      state.log2_lmul = 1;
    } else if (vlmul == 3'b100) {
      unpredictable("VLMUL value 0b100 is reserved");
    }

    return state;
  }
}

function vector_lmul_bits {
  returns U32
  arguments VectorState state
  description {
    Return the number of data bits in the current vector register group.
  }
  body {
    if (state.lmul_type == VectorLmulType::Multiply) {
      return VLEN << state.log2_lmul;
    }
    return VLEN >> state.log2_lmul;
  }
}

function vector_element_group_legal {
  returns Boolean
  arguments
    VectorState state,
    U32 group_bits,
    U32 group_elements
  description {
    Check the shared element-group constraints used by vector crypto instructions.
  }
  body {
    return vector_lmul_bits(state) >= group_bits &&
      (CSR[vl].VALUE % group_elements) == 0 &&
      (CSR[vstart].VALUE % group_elements) == 0;
  }
}

function vector_register_group_registers {
  returns U32
  arguments VectorState state
  description {
    Return the number of physical vector registers in the current LMUL group.
  }
  body {
    return state.lmul_type == VectorLmulType::Multiply ?
      1 << state.log2_lmul : 1;
  }
}

function vector_element_group_registers {
  returns U32
  arguments U32 group_bits
  description {
    Return the number of physical vector registers occupied by one element group.
  }
  body {
    return (group_bits + VLEN - 1) / VLEN;
  }
}

function vector_read_eg128 {
  returns Bits<128>
  arguments
    Bits<5> base_reg,
    U32 element
  description {
    Read a 128-bit element group beginning at the specified SEW=32 element.
  }
  body {
    VectorState state = vector_state();
    U32 elems_per_reg = VLEN >> state.log2_sew;
    U32 reg0 = element / elems_per_reg;
    U32 reg1 = (element + 1) / elems_per_reg;
    U32 reg2 = (element + 2) / elems_per_reg;
    U32 reg3 = (element + 3) / elems_per_reg;
    U32 bit0 = (element % elems_per_reg) * 32;
    U32 bit1 = ((element + 1) % elems_per_reg) * 32;
    U32 bit2 = ((element + 2) % elems_per_reg) * 32;
    U32 bit3 = ((element + 3) % elems_per_reg) * 32;

    return {
      V[base_reg + reg3][bit3 + 31:bit3],
      V[base_reg + reg2][bit2 + 31:bit2],
      V[base_reg + reg1][bit1 + 31:bit1],
      V[base_reg + reg0][bit0 + 31:bit0]
    };
  }
}

function vector_write_eg128 {
  arguments
    Bits<5> base_reg,
    U32 element,
    Bits<128> value
  description {
    Write a 128-bit element group beginning at the specified SEW=32 element.
  }
  body {
    VectorState state = vector_state();
    U32 elems_per_reg = VLEN >> state.log2_sew;
    U32 reg0 = element / elems_per_reg;
    U32 reg1 = (element + 1) / elems_per_reg;
    U32 reg2 = (element + 2) / elems_per_reg;
    U32 reg3 = (element + 3) / elems_per_reg;
    U32 bit0 = (element % elems_per_reg) * 32;
    U32 bit1 = ((element + 1) % elems_per_reg) * 32;
    U32 bit2 = ((element + 2) % elems_per_reg) * 32;
    U32 bit3 = ((element + 3) % elems_per_reg) * 32;

    V[base_reg + reg0][bit0 + 31:bit0] = value[31:0];
    V[base_reg + reg1][bit1 + 31:bit1] = value[63:32];
    V[base_reg + reg2][bit2 + 31:bit2] = value[95:64];
    V[base_reg + reg3][bit3 + 31:bit3] = value[127:96];
  }
}

function vector_read_eg256 {
  returns Bits<256>
  arguments
    Bits<5> base_reg,
    U32 element
  description {
    Read a 256-bit element group beginning at the specified SEW=32 element.
  }
  body {
    VectorState state = vector_state();
    U32 elems_per_reg = VLEN >> state.log2_sew;
    Bits<256> value = 0;

    for (U32 word = 0; word < 8; word++) {
      U32 word_element = element + word;
      U32 reg_off = word_element / elems_per_reg;
      U32 start_bit = (word_element % elems_per_reg) * 32;
      value[word * 32 + 31:word * 32] = V[base_reg + reg_off][start_bit + 31:start_bit];
    }

    return value;
  }
}

function vector_write_eg256 {
  arguments
    Bits<5> base_reg,
    U32 element,
    Bits<256> value
  description {
    Write a 256-bit element group beginning at the specified SEW=32 element.
  }
  body {
    VectorState state = vector_state();
    U32 elems_per_reg = VLEN >> state.log2_sew;

    for (U32 word = 0; word < 8; word++) {
      U32 word_element = element + word;
      U32 reg_off = word_element / elems_per_reg;
      U32 start_bit = (word_element % elems_per_reg) * 32;
      V[base_reg + reg_off][start_bit + 31:start_bit] = value[word * 32 + 31:word * 32];
    }
  }
}

function vector_read_eg256_sew64 {
  returns Bits<256>
  arguments
    Bits<5> base_reg,
    U32 element
  description {
    Read a four-element SEW=64 group.
  }
  body {
    VectorState state = vector_state();
    U32 elems_per_reg = VLEN >> state.log2_sew;
    Bits<256> value = 0;

    for (U32 word = 0; word < 4; word++) {
      U32 word_element = element + word;
      U32 reg_off = word_element / elems_per_reg;
      U32 start_bit = (word_element % elems_per_reg) * 64;
      value[word * 64 + 63:word * 64] = V[base_reg + reg_off][start_bit + 63:start_bit];
    }

    return value;
  }
}

function vector_write_eg256_sew64 {
  arguments
    Bits<5> base_reg,
    U32 element,
    Bits<256> value
  description {
    Write a four-element SEW=64 group.
  }
  body {
    VectorState state = vector_state();
    U32 elems_per_reg = VLEN >> state.log2_sew;

    for (U32 word = 0; word < 4; word++) {
      U32 word_element = element + word;
      U32 reg_off = word_element / elems_per_reg;
      U32 start_bit = (word_element % elems_per_reg) * 64;
      V[base_reg + reg_off][start_bit + 63:start_bit] = value[word * 64 + 63:word * 64];
    }
  }
}

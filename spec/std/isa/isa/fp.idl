%version: 1.0

# Many functions in this file (and all prefixed with softfloat_*) are
# adapted from berkeley-softfloat-3 by John R. Hauser
# (https://github.com/ucb-bar/berkeley-softfloat-3)
# Files in berkely-softfloat-3 repository are licensed under BSD-3-clause.

# floating point register file
U32 FLEN = implemented?(ExtensionName::Q) ? 8'd128 : (implemented?(ExtensionName::D) ? 7'd64 : 7'd32);

# FP constants
Bits<32> SP_POS_INF       = 32'b0_11111111_00000000000000000000000;
Bits<32> SP_NEG_INF       = 32'b1_11111111_00000000000000000000000;
Bits<32> SP_POS_ZERO      = 32'b0_00000000_00000000000000000000000;
Bits<32> SP_NEG_ZERO      = 32'b1_00000000_00000000000000000000000;
Bits<32> SP_CANONICAL_NAN = 32'b0_11111111_10000000000000000000000;

Bits<16> HP_CANONICAL_NAN = 16'b0_11111_1000000000;

# Double-precision (f64) FP constants
Bits<64> DP_POS_INF       = 64'h7FF0_0000_0000_0000;
Bits<64> DP_NEG_INF       = 64'hFFF0_0000_0000_0000;
Bits<64> DP_POS_ZERO      = 64'h0000_0000_0000_0000;
Bits<64> DP_NEG_ZERO      = 64'h8000_0000_0000_0000;
Bits<64> DP_CANONICAL_NAN = 64'h7FF8_0000_0000_0000;

Bits<32> WORD_NEG_OVERFLOW = 32'h8000_0000; # minimum signed 32-bit integer
Bits<32> WORD_POS_OVERFLOW = 32'h7FFF_FFFF; # maximum signed 32-bit integer

Bits<32> UI32_NEG_OVERFLOW = 32'h0000_0000; # minimum unsigned 32-bit integer
Bits<32> UI32_POS_OVERFLOW = 32'hFFFF_FFFF; # maximum unsigned 32-bit integer

Bits<32> UI32_NAN          = 32'hFFFF_FFFF; # NaN to unsigned 32-bit integer
Bits<32> I32_NAN           = 32'h7FFF_FFFF; # NaN to signed 32-bit integer

Bits<64> I64_NEG_OVERFLOW  = 64'h8000_0000_0000_0000; # minimum signed 64-bit integer
Bits<64> I64_POS_OVERFLOW  = 64'h7FFF_FFFF_FFFF_FFFF; # maximum signed 64-bit integer
Bits<64> UI64_NEG_OVERFLOW = 64'h0000_0000_0000_0000; # minimum unsigned 64-bit integer
Bits<64> UI64_POS_OVERFLOW = 64'hFFFF_FFFF_FFFF_FFFF; # maximum unsigned 64-bit integer
Bits<64> UI64_NAN          = 64'hFFFF_FFFF_FFFF_FFFF; # NaN to unsigned 64-bit integer
Bits<64> I64_NAN           = 64'h7FFF_FFFF_FFFF_FFFF; # NaN to signed 64-bit integer

enum RoundingMode {
  RNE 0b000 # Round to Nearest, ties to Even
  RTZ 0b001 # Round toward Zero
  RDN 0b010 # Round Down (towards -&infin;)
  RUP 0b011 # Round Up (towards +&infin;)
  RMM 0b100 # Round to Nearest, ties to Max Magnitude
  ROD 0b110 # Round to Odd (jam); used by vfncvt.rod.f.f.w narrowing
  DYN 0b111 # Dynamic; use rm field in instruction
}

enum FpFlag {
  NX 0b00001 # Inexact
  UF 0b00010 # Underflow
  OF 0b00100 # Overflow
  DZ 0b01000 # Divide by zero
  NV 0b10000 # Invalid Operation
}

# Operation modifier for fused multiply-add
enum F32MulAddOp {
  Softfloat_mulAdd_addC    0 # (a * b) + c
  Softfloat_mulAdd_subC    1 # (a * b) - c  (negate c)
  Softfloat_mulAdd_subProd 2 # -(a * b) + c (negate product)
}

function set_fp_flag {
  arguments
    FpFlag flag
  description {
    Add +flag+ to the sticky flags bits in CSR[fcsr]
  }
  body {
    if (flag == FpFlag::NX) {
      CSR[fcsr].NX = 1;
    } else if (flag == FpFlag::UF) {
      CSR[fcsr].UF = 1;
    } else if (flag == FpFlag::OF) {
      CSR[fcsr].OF = 1;
    } else if (flag == FpFlag::DZ) {
      CSR[fcsr].DZ = 1;
    } else if (flag == FpFlag::NV) {
      CSR[fcsr].NV = 1;
    }
  }
}

function rm_to_mode {
  returns RoundingMode
  arguments
    Bits<3> rm,       # rm field from an instruction encoding
    Bits<32> encoding # instruction encoding, needed to raise an exception
  description {
    Convert +rm+ to a RoundingMode.

    +encoding+ is the full encoding of the instruction +rm+ comes from.

    Will raise an IllegalInstruction exception if rm is a
    reserved encoding.
  }
  body {
    if (rm == $bits(RoundingMode::RNE)) {
      return RoundingMode::RNE;
    } else if (rm == $bits(RoundingMode::RTZ)) {
      return RoundingMode::RTZ;
    } else if (rm == $bits(RoundingMode::RDN)) {
      return RoundingMode::RDN;
    } else if (rm == $bits(RoundingMode::RUP)) {
      return RoundingMode::RUP;
    } else if (rm == $bits(RoundingMode::RMM)) {
      return RoundingMode::RMM;
    } else if (rm == $bits(RoundingMode::DYN)) {
      return $enum(RoundingMode, CSR[fcsr].FRM);
    } else {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }
  }
}

function mark_f_state_dirty {
  description {
    Potentially updates `mstatus.FS` to the Dirty (3) state, depending on configuration settings.
  }
  body {
    if (HW_MSTATUS_FS_DIRTY_UPDATE== "precise") {
      CSR[mstatus].FS = 3; # set dirty state
    } else if (HW_MSTATUS_FS_DIRTY_UPDATE == "imprecise") {
      unpredictable("The hart may or may not update mstatus.FS now");
    }
  }
}

function nan_box {
  returns XReg
  arguments U32 FROM_SIZE, U32 TO_SIZE, XReg from_value
  description {
    Produces a properly NaN-boxed floating-point value from a floating-point value
    of smaller size by adding all 1's to the upper bits.
  }
  body {
    assert(FROM_SIZE < TO_SIZE, "Bad arguments; FROM_SIZE must be less than TO_SIZE");

    # Mask from_value to FROM_SIZE bits, then set all upper bits (from FROM_SIZE to 63) to 1.
    # Using OR instead of concat avoids the 96-bit intermediate that truncation would discard.
    return (from_value & ((64'h1 << FROM_SIZE) - 1)) | ~((64'h1 << FROM_SIZE) - 1);
  }
}

function check_f_ok {
  arguments
    Bits<INSTR_ENC_SIZE> encoding
  description {
    Checks if instructions from the `F` extension can be executed, and, if not,
    raise an exception.
  }
  body {
    if (MUTABLE_MISA_F && CSR[misa].F == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }

    if (CSR[mstatus].FS == 0) {
      raise(ExceptionCode::IllegalInstruction, mode(), encoding);
    }
  }
}

function is_sp_neg_inf? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Return true if +sp_value+ is negative infinity.
  }
  body {
    return sp_value == SP_NEG_INF;
  }
}

function is_sp_pos_inf? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Return true if +sp_value+ is positive infinity.
  }
  body {
    return sp_value == SP_POS_INF;
  }
}

function is_sp_neg_norm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a negative normal number.
  }
  body {
    return
      (sp_value[31] == 1)                 # negative
      && (sp_value[30:23] != 0b11111111)  # not inf/NaN
      && (sp_value[30:23] != 0b00000000); # not zero or subnormal
  }
}

function is_sp_pos_norm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a positive normal number.
  }
  body {
    return
      (sp_value[31] == 0)                 # positive
      && (sp_value[30:23] != 0b11111111)  # not inf/NaN
      && (sp_value[30:23] != 0b00000000); # not zero
  }
}

function is_sp_neg_subnorm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a negative subnormal number.
  }
  body {
    return
      (sp_value[31] == 1)        # negative
      && (sp_value[30:23] == 0)  # subnormal exponent
      && (sp_value[22:0] != 0);  # not zero
  }
}

function is_sp_pos_subnorm? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a positive subnormal number.
  }
  body {
    return
      (sp_value[31] == 0)        # positive
      && (sp_value[30:23] == 0)  # subnormal exponent
      && (sp_value[22:0] != 0);  # not zero
  }
}

function is_sp_neg_zero? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is negative zero.
  }
  body {
    return sp_value == SP_NEG_ZERO;
  }
}

function is_sp_pos_zero? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is positive zero.
  }
  body {
    return sp_value == SP_POS_ZERO;
  }
}

function is_sp_nan? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a NaN (quiet or signaling)
  }
  body {
    return
      (sp_value[30:23] == 0b11111111)
      && (sp_value[22:0] != 0);    # signaling bit
  }
}

function is_sp_signaling_nan? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a signaling NaN
  }
  body {
    return
      (sp_value[30:23] == 0b11111111)
      && (sp_value[22] == 0)    # signaling bit
      && (sp_value[21:0] != 0); # not infinity
  }
}

function is_sp_quiet_nan? {
  returns Boolean
  arguments Bits<32> sp_value
  description {
    Returns true if +sp_value+ is a quiet NaN
  }
  body {
    return
      (sp_value[30:23] == 0b11111111)
      && (sp_value[22] == 1);    # signaling bit
  }
}

function softfloat_shiftRightJam32 {
  returns Bits<32>
  arguments
    Bits<32> a,
    Bits<32> dist
  description {
    Shifts +a+ right by the number of bits given in +dist+, which must not
    be zero.  If any nonzero bits are shifted off, they are "jammed" into the
    least-significant bit of the shifted value by setting the least-significant
    bit to 1.  This shifted-and-jammed value is returned.
    The value of +dist+ can be arbitrarily large.  In particular, if +dist+ is
    greater than 32, the result will be either 0 or 1, depending on whether +a+
    is zero or nonzero.
  }
  body {
    return (dist < 31) ? a>>dist | ((a[dist-1:0] != 0) ? 1 : 0) : ((a != 0) ? 1 : 0);
  }
}

function softfloat_shiftRightJam64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<32> dist
  description {
     Shifts +a+ right by the number of bits given in +dist+, which must not
     be zero.  If any nonzero bits are shifted off, they are "jammed" into the
     least-significant bit of the shifted value by setting the least-significant
     bit to 1.  This shifted-and-jammed value is returned.

     The value of 'dist' can be arbitrarily large.  In particular, if +dist+ is
     greater than 64, the result will be either 0 or 1, depending on whether +a+
     is zero or nonzero.
  }
  body {
    return (dist < 63) ? a>>dist | ((a[dist-1:0] != 0) ? 1 : 0) : ((a != 0) ? 1 : 0);
  }
}

function softfloat_roundToI32 {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    RoundingMode roundingMode
  description {
    Round to signed 32-bit integer, using +rounding_mode+
  }
  body {
    Bits<16> roundIncrement = 0x800;
    if (
      (roundingMode != RoundingMode::RMM)
      && (roundingMode != RoundingMode::RNE)
    ) {
      roundIncrement = 0;
      if (
        sign == 1
          ? (roundingMode == RoundingMode::RDN)
          : (roundingMode == RoundingMode::RUP)
      ) {
        roundIncrement = 0xFFF;
      }
    }
    Bits<16> roundBits = sig & 0xFFF;
    sig = sig + roundIncrement;
    if ((sig & 0xFFFFF00000000000) != 0) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    Bits<32> sig32 = sig >> 12;
    if (
      (roundBits == 0x800 && (roundingMode == RoundingMode::RNE))
    ) {
      sig32 = sig32 & ~32'b1;
    }

    Bits<32> z = (sign == 1) ? -sig32 : sig32;
    if ((z != 0) && (($signed(z) < 's0) != (sign == 1))) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    if (roundBits != 0) {
      set_fp_flag(FpFlag::NX);
    }
    return z;
  }
}

function f32_muladd {
  returns U32
  arguments
    U32 a,
    U32 b,
    U32 c,
    F32MulAddOp op,
    RoundingMode mode
  description {
    Fused multiply-add for single-precision floats.
    Computes (a * b) + c, with sign modifications based on op:
      Softfloat_mulAdd_addC:    (a * b) + c
      Softfloat_mulAdd_subC:    (a * b) - c  (negate c)
      Softfloat_mulAdd_subProd: -(a * b) + c (negate product)
    Translated from Berkeley Softfloat softfloat_mulAddF32.
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b) || is_sp_signaling_nan?(c)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1>  signA    = signF32UI(a);
    Bits<16>  expA     = expF32UI(a);
    Bits<32> sigA     = fracF32UI(a);
    Bits<1>  signB    = signF32UI(b);
    Bits<16>  expB     = expF32UI(b);
    Bits<32> sigB     = fracF32UI(b);
    Bits<1>  signC    = signF32UI(c) ^ ((op == F32MulAddOp::Softfloat_mulAdd_subC) ? 1 : 0);
    Bits<16>  expC     = expF32UI(c);
    Bits<32> sigC     = fracF32UI(c);
    Bits<1>  signProd = (signA ^ signB) ^ ((op == F32MulAddOp::Softfloat_mulAdd_subProd) ? 1 : 0);

    Bits<32> magBits;
    Bits<64> sig64Z;

    # Handle NaN/Inf in A
    if (expA == 0xFF) {
      if ((sigA != 0) || ((expB == 0xFF) && (sigB != 0))) {
        return SP_CANONICAL_NAN;
      }
      magBits = expB | sigB;
      if (magBits != 0) {
        U32 zA = packToF32UI(signProd, 0xFF, 0);
        if (expC != 0xFF) {
          return zA;
        }
        if (sigC != 0) {
          return SP_CANONICAL_NAN;
        }
        if (signProd == signC) {
          return zA;
        }
      }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in B
    if (expB == 0xFF) {
      if (sigB != 0) {
        return SP_CANONICAL_NAN;
      }
      magBits = expA | sigA;
      if (magBits != 0) {
        U32 zB = packToF32UI(signProd, 0xFF, 0);
        if (expC != 0xFF) {
          return zB;
        }
        if (sigC != 0) {
          return SP_CANONICAL_NAN;
        }
        if (signProd == signC) {
          return zB;
        }
      }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in C
    if (expC == 0xFF) {
      if (sigC != 0) {
        return SP_CANONICAL_NAN;
      }
      return c;
    }

    # Handle zero/subnormal A
    if (expA == 0) {
      if (sigA == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF32UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return c;
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    # Handle zero/subnormal B
    if (expB == 0) {
      if (sigB == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF32UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return c;
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    # Compute product exponent and significand
    Bits<16> expProd = expA + expB - 16'h007E;
    sigA = (sigA | 32'h00800000) << 7;
    sigB = (sigB | 32'h00800000) << 7;
    U64 sigProd = sigA `* sigB;
    if (sigProd < 64'h2000000000000000) {
      expProd = expProd - 1;
      sigProd = sigProd << 1;
    }
    Bits<1>  signZ = signProd;
    Bits<16> expZ;
    Bits<32> sigZ;

    # Handle zero/subnormal C
    if (expC == 0) {
      if (sigC == 0) {
        expZ = expProd - 1;
        sigZ = softfloat_shiftRightJam64(sigProd, 31);
        return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigC);
      expC = norm.exp;
      sigC = norm.sig;
    }
    sigC = (sigC | 0x00800000) << 6;

    Bits<16> expDiff = expProd - expC;

    if (signProd == signC) {
      # Same sign: add magnitudes
      if ($signed(expDiff) <= 0s) {
        expZ = expC;
        sigZ = sigC + softfloat_shiftRightJam64(sigProd, 32 - expDiff);
      } else {
        expZ = expProd;
        sig64Z = sigProd + softfloat_shiftRightJam64(sigC `<< 32, expDiff);
        sigZ = softfloat_shiftRightJam64(sig64Z, 32);
      }
      if (sigZ < 0x40000000) {
        expZ = expZ - 1;
        sigZ = sigZ << 1;
      }
      return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
    } else {
      # Different signs: subtract magnitudes
      U64 sig64C = sigC `<< 32;
      if ($signed(expDiff) < 0s) {
        signZ = signC;
        expZ = expC;
        sig64Z = sig64C - softfloat_shiftRightJam64(sigProd, -expDiff);
      } else if (expDiff == 0) {
        expZ = expProd;
        sig64Z = sigProd - sig64C;
        if (sig64Z == 0) {
          return packToF32UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        if ((sig64Z & 64'h8000000000000000) != 0) {
          signZ = signZ ^ 1;
          sig64Z = -sig64Z;
        }
      } else {
        expZ = expProd;
        sig64Z = sigProd - softfloat_shiftRightJam64(sig64C, expDiff);
      }
      Bits<8> shiftDist = count_leading_zeros_64(64, sig64Z) - 1;
      expZ = expZ - shiftDist;
      shiftDist = shiftDist - 8'h20;
      if ($signed(shiftDist) < 0s) {
        sigZ = softfloat_shiftRightJam64(sig64Z, -shiftDist);
      } else {
        sigZ = sig64Z << shiftDist;
      }
      return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
    }
  }
}

function f32_sqrt {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Computes the square root of a 32-bit floating point number.
    Translated from Berkeley Softfloat f32_sqrt.
  }
  body {
    if (is_sp_signaling_nan?(a)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF32UI(a);
    Bits<16> expA  = expF32UI(a);
    Bits<32> fracA = fracF32UI(a);

    if (expA == 8'hFF) {
      if (fracA != 0) {
        return SP_CANONICAL_NAN;
      }
      if (signA == 0) { return a; }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }
    if (signA == 1) {
      if ((expA == 0) && (fracA == 0)) { return a; }
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }
    if (expA == 0) {
      if (fracA == 0) { return a; }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(fracA);
      expA = norm.exp;
      fracA = norm.sig;
    }

    Bits<16> adjExp = expA - 16'h007F;
    Bits<16> expZ = ((adjExp >> 1) ^ (adjExp & 16'h8000)) + 16'h007E;
    Bits<1> oddExpA = expA[0];
    Bits<32> sigA32 = (fracA | 32'h00800000) << 8;
    Bits<32> sigZ = (sigA32 `* softfloat_approxRecipSqrt32_1(oddExpA, sigA32)) >> 32;
    if (oddExpA == 1) {
      sigZ = sigZ >> 1;
    }
    sigZ = sigZ + 2;

    if ((sigZ & 0x3F) < 2) {
      Bits<32> shiftedSigZ = sigZ >> 2;
      Bits<32> negRem = shiftedSigZ * shiftedSigZ;
      sigZ = sigZ & ~32'h3;
      if ((negRem & 0x80000000) != 0) {
        sigZ = sigZ | 1;
      } else {
        if (negRem != 0) { sigZ = sigZ - 1; }
      }
    }

    return softfloat_roundPackToF32(0, expZ, sigZ, mode);
  }
}

# Lookup tables for reciprocal and reciprocal-sqrt approximation (Berkeley Softfloat)
Bits<16> softfloat_approxRecip_1k0s[16] = [
  0xFFC4, 0xF0BE, 0xE363, 0xD76F, 0xCCAD, 0xC2F0, 0xBA16, 0xB201,
  0xAA97, 0xA3C6, 0x9D7A, 0x97A6, 0x923C, 0x8D32, 0x887E, 0x8417
];
Bits<16> softfloat_approxRecip_1k1s[16] = [
  0xF0F1, 0xD62C, 0xBFA1, 0xAC77, 0x9C0A, 0x8DDB, 0x8185, 0x76BA,
  0x6D3B, 0x64D4, 0x5D5C, 0x56B1, 0x50B6, 0x4B55, 0x4679, 0x4211
];
Bits<16> softfloat_approxRecipSqrt_1k0s[16] = [
  0xB4C9, 0xFFAB, 0xAA7D, 0xF11C, 0xA1C5, 0xE4C7, 0x9A43, 0xDA29,
  0x93B5, 0xD0E5, 0x8DED, 0xC8B7, 0x88C6, 0xC16D, 0x8424, 0xBAE1
];
Bits<16> softfloat_approxRecipSqrt_1k1s[16] = [
  0xA5A5, 0xEA42, 0x8C21, 0xC62D, 0x788F, 0xAA7F, 0x6928, 0x94B6,
  0x5CC7, 0x8335, 0x52A6, 0x74E2, 0x4A3E, 0x68FE, 0x432B, 0x5EFD
];

function softfloat_approxRecip32_1 {
  returns U32
  arguments
    Bits<32> a
  description {
    Returns floor(0x7FFFFFFFFFFFFFFF / a), matching the platform-specific
    Berkeley SoftFloat macro on 64-bit hosts. Computed via binary long division.
  }
  body {
    Bits<64> a64 = {32'h0, a};
    Bits<64> a_top = a64 << 31;
    Bits<64> rem = 64'h7FFFFFFFFFFFFFFF;
    Bits<32> q = 0;
    for (U32 i = 0; i < 32; i++) {
      Bits<64> d = a_top >> i;
      if (rem >= d) {
        q = q | (32'h1 << (31 - i));
        rem = rem - d;
      }
    }
    return q;
  }
}

function softfloat_approxRecipSqrt32_1 {
  returns U32
  arguments
    Bits<1> oddExpA,
    Bits<32> a
  description {
    Returns a 32-bit approximation of 1/sqrt(a).
    Translated from Berkeley Softfloat softfloat_approxRecipSqrt32_1.
  }
  body {
    Bits<8> index = ((a >> 27) & 0xE) + oddExpA;
    Bits<16> eps = a >> 12;
    Bits<16> r0 = softfloat_approxRecipSqrt_1k0s[index]
                  - ((softfloat_approxRecipSqrt_1k1s[index] `* eps) >> 20);
    Bits<32> eSqrR0 = r0 `* r0;
    if (oddExpA == 0) {
      eSqrR0 = eSqrR0 << 1;
    }
    Bits<32> sigma0 = ~((eSqrR0 `* a) >> 23);
    Bits<32> r = (r0 `<< 16) + ((r0 `* sigma0) >> 25);
    Bits<32> sqrSigma0 = (sigma0 `* sigma0) >> 32;
    Bits<32> adj = ((r >> 1) + (r >> 3) - (r0 `<< 14));
    r = r + ((adj `* sqrSigma0) >> 48);
    if ((r & 32'h80000000) == 0) {
      r = 32'h80000000;
    }
    return r;
  }
}

function f32_div {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Divides two 32-bit floating point numbers.
    Translated from Berkeley Softfloat f32_div.
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF32UI(a);
    Bits<16> expA  = expF32UI(a);
    Bits<32> sigA = fracF32UI(a);
    Bits<1> signB = signF32UI(b);
    Bits<16> expB  = expF32UI(b);
    Bits<32> sigB = fracF32UI(b);
    Bits<1> signZ = signA ^ signB;

    Bits<16> expZ;

    if (expA == 8'hFF) {
      if (sigA != 0) {
        return SP_CANONICAL_NAN;
      }
      if (expB == 8'hFF) {
        if (sigB != 0) {
          return SP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::NV);
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(signZ, 8'hFF, 0);
    }
    if (expB == 8'hFF) {
      if (sigB != 0) {
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(signZ, 0, 0);
    }

    if (expB == 0) {
      if (sigB == 0) {
        if ((expA == 0) && (sigA == 0)) {
          set_fp_flag(FpFlag::NV);
          return SP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::DZ);
        return packToF32UI(signZ, 8'hFF, 0);
      }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    if (expA == 0) {
      if (sigA == 0) { return packToF32UI(signZ, 0, 0); }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    expZ = expA - expB + 16'h007E;
    sigA = sigA | 32'h00800000;
    sigB = sigB | 32'h00800000;

    if (sigA < sigB) {
      expZ = expZ - 1;
      sigA = sigA << 8;
    } else {
      sigA = sigA << 7;
    }
    sigB = sigB << 8;

    Bits<32> recip32 = softfloat_approxRecip32_1(sigB);
    Bits<32> sigZ = (sigA `* recip32) >> 32;
    sigZ = sigZ + 2;

    if ((sigZ & 7) <= 2) {
      sigZ = sigZ & ~32'h3;
      Bits<64> rem = (sigA `<< 31) - (sigZ `* sigB);
      if ((rem & 64'h8000000000000000) != 0) {
        sigZ = sigZ - 4;
      } else {
        if ( rem != 0 ) {
          sigZ = sigZ | 1;
        }
      }
    }

    return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
  }
}

function f32_mul {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Multiplies two 32-bit floating point numbers.
    Translated from Berkeley Softfloat f32_mul.
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }
    Bits<1> signA = signF32UI(a);
    Bits<16> expA  = expF32UI(a);
    Bits<23> fracA = fracF32UI(a);
    Bits<1> signB = signF32UI(b);
    Bits<16> expB  = expF32UI(b);
    Bits<23> fracB = fracF32UI(b);
    Bits<1> signZ = signA ^ signB;

    Bits<32> sigA = fracA;
    Bits<32> sigB = fracB;
    Bits<16> expZ;
    Bits<32> sigZ;

    if (expA == 8'hFF) {
      if ((fracA != 0) || ((expB == 8'hFF) && (fracB != 0))) {
        return SP_CANONICAL_NAN;
      }
      if ((expB == 0) && (fracB == 0)) {
        set_fp_flag(FpFlag::NV);
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(signZ, 8'hFF, 0);
    }
    if (expB == 8'hFF) {
      if (fracB != 0) {
        return SP_CANONICAL_NAN;
      }
      if ((expA == 0) && (fracA == 0)) {
        set_fp_flag(FpFlag::NV);
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(signZ, 8'hFF, 0);
    }

    if (expA == 0) {
      if (fracA == 0) { return packToF32UI(signZ, 0, 0); }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(fracA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    if (expB == 0) {
      if (fracB == 0) { return packToF32UI(signZ, 0, 0); }
      ExpAndSig norm = softfloat_normSubnormalF32Sig(fracB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    expZ = expA + expB - 16'h007F;
    sigA = (sigA | 32'h00800000)<<7;
    sigB = (sigB | 32'h00800000)<<8;
    sigZ = softfloat_shiftRightJam64(sigA `* sigB, 32);
    if (sigZ < 0x40000000 ) {
      expZ = expZ - 1;
      sigZ = sigZ << 1;
    }

    return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
  }
}

function f32_to_i64 {
  returns Bits<64>
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to a signed 64-bit integer.
    Translated from Berkeley Softfloat f32_to_i64.
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);

    Bits<16> shiftDist = 16'hBE - exp;
    Bits<64> sig64;
    Bits<64> extra;

    if ($signed(shiftDist) < 0s) {
      set_fp_flag(FpFlag::NV);
      if ((exp == 16'hFF) && (sig != 0)) {
        return I64_NAN;
      } else {
        return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
      }
    }

    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 40;
    extra = 0;
    if (shiftDist != 0) {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra( sig64, 0, $signed(shiftDist) );
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToI64( sign, sig64, extra, mode );
  }
}

struct TwoU64s {
  Bits<64> u1;
  Bits<64> u2;
}

function softfloat_shiftRightJam64Extra {
  returns TwoU64s
  arguments
    Bits<64> a,
    Bits<64> extra,
    Bits<32> dist
  description {
    Shifts the 128 bits formed by concatenating 'a' and 'extra' right by 64
    _plus_ the number of bits given in 'dist', which must not be zero.  This
    shifted value is at most 64 nonzero bits and is returned in the 'v' field
    of the 'struct uint64_extra' result.  The 64-bit 'extra' field of the result
    contains a value formed as follows from the bits that were shifted off:  The
    _last_ bit shifted off is the most-significant bit of the 'extra' field, and
    the other 63 bits of the 'extra' field are all zero if and only if _all_but_
    _the_last_ bits shifted off were all zero.
      (This function makes more sense if 'a' and 'extra' are considered to form
    an unsigned fixed-point number with binary point between 'a' and 'extra'.
    This fixed-point value is shifted right by the number of bits given in
    'dist', and the integer part of this shifted value is returned in the 'v'
    field of the result.  The fractional part of the shifted value is modified
    as described above and returned in the 'extra' field of the result.)
  }
  body {
    TwoU64s z;

    if (dist < 64) {
      z.u1 = a >> dist;
      z.u2 = a << (-dist & 63);
    } else {
      z.u1 = 0;
      z.u2 = (dist == 64) ? a : ((a != 0) ? 1 : 0);
    }
    z.u2 = z.u2 | ((extra != 0) ? 1 : 0);

    return z;
  }
}

function f32_to_ui64 {
  returns Bits<64>
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to an unsigned 64-bit integer.
    Translated from Berkeley Softfloat f32_to_ui64.
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);

    Bits<16> shiftDist;
    Bits<64> sig64, extra;

    # shiftDist = 0xBE - exp  (0xBE = 190 = 127 + 63)
    shiftDist = 16'hBE - exp;

    if ($signed(shiftDist) < 0s) {
      set_fp_flag(FpFlag::NV);
      if ((exp == 0xFF) && (sig != 0)) {
        return UI64_NAN;
      } else if (sign != 0) {
        return UI64_NEG_OVERFLOW;
      } else {
        return UI64_POS_OVERFLOW;
      }
    }

    if (exp != 0) {
      sig = sig | 32'h00800000;
    }
    sig64 = sig `<< 40;
    extra = 0;
    if (shiftDist != 0) {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig64, 0, $signed(shiftDist));
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToUI64( sign, sig64, extra, mode );
  }
}

function i64_to_f32 {
  returns U32
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts 64-bit signed integer to 32-bit floating point number.
    Translated from Berkeley Softfloat i64_to_f32.
  }
  body {
    Bits<1> sign = a[63];
    Bits<64> absA;

    if (sign == 1) {
      absA = -a;
    } else {
      absA = a;
    }

    # count_leading_zeros<64> returns the number of leading zeros
    Bits<8> shiftDist = count_leading_zeros(64, absA) - 40;
    Bits<32> sig;

    if ($signed(shiftDist) >= 0s) {
      if (a != 0) {
        return packToF32UI(sign, 16'h95 - shiftDist, absA << shiftDist);
      } else {
        return 0;
      }
    } else {
      shiftDist = shiftDist + 7;
      if ($signed(shiftDist) < 0s) {
        sig = softfloat_shortShiftRightJam64( absA, -shiftDist );
      } else {
        sig = absA << shiftDist;
      }
      return softfloat_roundPackToF32(sign, 8'h9C - shiftDist, sig, mode);
    }
  }
}

function ui64_to_f32 {
  returns U32
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts 64-bit unsigned integer to 32-bit floating point number.
    Translated from Berkeley Softfloat ui64_to_f32.
  }
  body {
    Bits<8> shiftDist = count_leading_zeros(64, a) - 40;
    Bits<32> sig;

    if (0s <= $signed(shiftDist)) {
      if (a != 0) {
        return packToF32UI(0, 8'h95 - shiftDist, a << shiftDist);
      } else {
        return 0;
      }
    } else {
      shiftDist = shiftDist + 7;
      if ($signed(shiftDist) < 0s) {
        sig = softfloat_shortShiftRightJam64(a, -shiftDist);
      } else {
        sig = a << shiftDist;
      }
      return softfloat_roundPackToF32(0, 8'h9C - shiftDist, sig, mode);
    }
  }
}

function softfloat_roundToUI32 {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    RoundingMode roundingMode
  description {
    Round to unsigned 32-bit integer, using +rounding_mode+
  }
  body {
    Bits<16> roundIncrement = 0x800;
    if (
      (roundingMode != RoundingMode::RMM)
      && (roundingMode != RoundingMode::RNE)
    ) {
      roundIncrement = 0;
      if ( sign == 1) {
        if (sig == 0) { return 0; }
        if (roundingMode == RoundingMode::RDN) { set_fp_flag(FpFlag::NV); }
      } else {
        if (roundingMode == RoundingMode::RUP) { roundIncrement = 0xFFF; }
      }
    }

    Bits<16> roundBits = sig & 0xFFF;
    sig = sig + roundIncrement;
    if ((sig & 0xFFFFF00000000000) != 0) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? UI32_NEG_OVERFLOW : UI32_POS_OVERFLOW;
    }

    Bits<32> z = sig >> 12;
    if (
      (roundBits == 0x800 && (roundingMode == RoundingMode::RNE))
    ) {
      z = z & ~32'b1;
    }

    if ((z != 0) && (sign == 1)) {
      set_fp_flag(FpFlag::NV);
      return sign == 1 ? UI32_NEG_OVERFLOW : UI32_POS_OVERFLOW;
    }

    if (roundBits != 0) {
      set_fp_flag(FpFlag::NX);
    }
    return z;
  }
}

function packToF32UI {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<8> exp,
    Bits<32> sig
  description {
    Pack components into a 32-bit value
  }
  body {
    return (sign `<< 31) + (exp `<< 23) + sig;
  }
}

function packToF16UI {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<5> exp,
    Bits<10> sig
  description {
    Pack components into a 16-bit value
  }
  body {
    return {sign, exp, sig};
  }
}

function softfloat_normSubnormalF16Sig {
  returns Bits<5>, Bits<10>
  arguments
    Bits<16> hp_value
  description {
    normalize subnormal half-precision value
  }
  body {
    Bits<8> shift_dist = count_leading_zeros(16, hp_value);
    return 1 - shift_dist, hp_value << shift_dist;
  }
}

function softfloat_roundPackToF32 {
  returns Bits<32>     # single precision value
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Round FP value according to +mdode+ and then pack it in IEEE format.
  }
  body {
    Bits<8> roundIncrement = 0x40;
    if ( (mode != RoundingMode::RNE) && (mode != RoundingMode::RMM)) {
      roundIncrement =
        (mode == ((sign != 0) ? RoundingMode::RDN : RoundingMode::RUP))
          ? 0x7F
          : 0;
    }
    Bits<8> roundBits = sig & 0x7f;

    if ( 0xFD <= exp ) {
      if ($signed(exp) < 's0) {
        Boolean isTiny =
          ($signed(exp) < -8's1) || (sig + roundIncrement < 0x80000000);
        sig = softfloat_shiftRightJam32( sig, -exp );
        exp = 0;
        roundBits = sig & 0x7F;
        if (isTiny && (roundBits != 0)) {
          set_fp_flag(FpFlag::UF);
        }
      } else if ('shFD < $signed(exp) || (0x80000000 <= sig + roundIncrement)) {
        set_fp_flag(FpFlag::OF);
        set_fp_flag(FpFlag::NX);
        return packToF32UI(sign, 0xFF, 0) - ((roundIncrement == 0) ? 1 : 0);
      }
    }

    sig = (sig + roundIncrement) >> 7;
    if (roundBits != 0) {
      set_fp_flag(FpFlag::NX);
      if (mode == RoundingMode::ROD) {
        sig = sig | 32'b1;
        return packToF32UI(sign, exp, sig);
      }
    }
    if ((roundBits == 0x40) && (mode == RoundingMode::RNE)) {
      sig = sig & ~32'b1;  # Clear only the LSB
    }
    # sig = sig & ~((((roundBits ^ 0x40) == 0) ? 32'0 : 32'1) & ((mode == RoundingMode::RNE) ? 32'1 : 32'0));
    if ( sig == 0 ) {
      exp = 0;
    }
    return packToF32UI(sign, exp, sig);
  }
}

function softfloat_normRoundPackToF32 {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Normalize, round, and pack into a 32-bit floating point value
  }
  body {
    Bits<8> shiftDist = count_leading_zeros(32, sig) - 1;
    exp = exp - shiftDist;
    if ((7 <= shiftDist) && (exp < 0xFD)) {
      return packToF32UI(sign, (sig != 0) ? exp : 0, sig << (shiftDist - 7));
    } else {
      return softfloat_roundPackToF32(sign, exp, sig << shiftDist, mode);
    }
  }
}

function signF32UI {
  returns Bits<1>
  arguments
    Bits<32> a
  description {
    Extract sign-bit of a 32-bit floating point number
  }
  body {
    return a[31];
  }
}

function expF32UI {
  returns Bits<8>
  arguments
    Bits<32> a
  description {
    Extract exponent of a 32-bit floating point number
  }
  body {
    return a[30:23];
  }
}

function fracF32UI {
  returns Bits<23>
  arguments
    Bits<32> a
  description {
    Extract significand of a 32-bit floating point number
  }
  body {
    return a[22:0];
  }
}

function returnNonSignalingNaN {
  returns U32
  arguments
    U32 a
  description {
    Returns a non-signalling NaN version of the floating-point number
    Does not modify the input
  }
  body {
    U32 a_copy = a;
    a_copy[22] = 1'b1;
    return a_copy;
  }
}

function returnMag {
  returns U32
  arguments
    U32 a
  description {
    Returns magnitude of the given number
    Does not modify the input
  }
  body {
    U32 a_copy = a;
    # make sign bit zero
    a_copy[31] = 1'b0;
    return a_copy;
  }
}

function returnLargerMag {
  returns U32
  arguments
    U32 a,
    U32 b
  description {
    Returns the larger number between a and b by magnitude
    If either number is signaling NaN then that is made quiet
  }
  body {
    U32 mag_a = returnMag(a);
    U32 mag_b = returnMag(b);
    U32 nonsig_a = returnNonSignalingNaN(a);
    U32 nonsig_b = returnNonSignalingNaN(b);
    if (mag_a < mag_b) {
      return nonsig_b;
    }
    if (mag_b < mag_a) {
      return nonsig_a;
    }
    return (nonsig_a < nonsig_b) ? nonsig_a : nonsig_b;
  }
}

function softfloat_addMagsF32 {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns sum of the magnitudes of two f32 numbers
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }

    # extract exponents and significands of a and b
    Bits<16> expA = expF32UI(a);
    Bits<32> sigA = fracF32UI(a);
    Bits<16> expB = expF32UI(b);
    Bits<32> sigB = fracF32UI(b);

    U32 sigZ;
    U32 z;
    Bits<1> signZ;

    Bits<16> expZ;

    # calculate difference of exponents
    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {
      if (expA == 8'd0) {
        z = a + b;
        return z; # if exponents of both numbers are zero, then return sum of both numbers
      }

      # check if A is infinity or NaN
      if (expA == 8'hFF) {
        # A is NaN if significand is non-zero and exponent is 8'hFF
        if ((sigA != 8'd0) || (sigB != 8'd0)) {
          return SP_CANONICAL_NAN;
        }
        # return infinity if A is infinity
        return a;
      }

      signZ = signF32UI(a);
      expZ = expA;
      sigZ = 32'h01000000 + sigA + sigB;

      # check if significand is even and exponent is less than 8'FE
      if (((sigZ & 0x1) == 0) && (expZ < 8'hFE)) {
        # if significand is even, remove trailing zero
        sigZ = sigZ >> 1;
        # pack the sign, exponent and significand
        return (32'h0 + (signZ << 31) + (expZ << 23) + sigZ);
      }

      sigZ = sigZ << 6;
    } else {

      signZ = signF32UI(a);

      sigA = sigA << 6;
      sigB = sigB << 6;

      # check if B has a bigger exponent value than A
      if ($signed(expDiff) < 0s) {
        # check if B is infinity or NaN
        if (expB == 8'hFF) {
          # B is NaN if exponent is 8'hFF and significand is non-zero
          if (sigB != 0) {
            return SP_CANONICAL_NAN;
          }
          # return infinity with same sign as A
          return packToF32UI(signZ, 8'hFF, 23'h0);
        }
        expZ  = expB;

        sigA = (expA == 0) ? 2*sigA : (sigA + 32'h20000000);
        sigA = softfloat_shiftRightJam32(sigA, -expDiff);
      } else {
        # check if A is infinity or NaN
        if (expA == 8'hFF) {
          # A is NaN if exponent is 8'hFF and significand is non-zero
          if (sigA != 0) {
            return SP_CANONICAL_NAN;
          }
            # return infinity with same sign as A
            return a;
        }

        expZ = expA;
        sigB = (expB == 0) ? 2*sigB : (sigB + 32'h20000000);
        sigB = softfloat_shiftRightJam32(sigB, expDiff);
      }

      sigZ = 32'h20000000 + sigA + sigB;
      if ( sigZ < 32'h40000000 ) {
            expZ = expZ - 1;
            sigZ =  sigZ << 1;
        }
    }
    return softfloat_roundPackToF32(signZ, expZ, sigZ, mode);
  }
}

function softfloat_subMagsF32 {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns difference of the magnitudes of two f32 numbers
  }
  body {
    if (is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
      set_fp_flag(FpFlag::NV);
    }

    # extract exponents and significands of a and b
    Bits<16> expA = expF32UI(a);
    Bits<32> sigA = fracF32UI(a);
    Bits<16> expB = expF32UI(b);
    Bits<32> sigB = fracF32UI(b);

    U32 sigZ;
    U32 z;
    Bits<1> signZ;

    Bits<16> expZ;

    U32 sigDiff;

    U32 sigX;
    U32 sigY;

    Bits<8> shiftDist;

    # calculate difference of exponents
    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {

      # check if A is infinity or NaN
      if (expA == 8'hFF) {
        if ((sigA != 8'd0) || (sigB != 8'd0)) {
          return SP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::NV);   # inf - inf is always invalid
        return SP_CANONICAL_NAN;
      }

      sigDiff = sigA - sigB;

      # check if no difference in significand
      if (sigDiff == 0) {
        # return -0 if rounding mode is round down, else return +0
        return packToF32UI(((mode == RoundingMode::RDN) ? 1 : 0),0,0);
      }

      if (expA != 0) {
        expA = expA - 1;
      }

      signZ = signF32UI(a);

      # if difference is negative, change the sign of the result
      if ($signed(sigDiff) < 32's0) {
        signZ = ~signZ;
        sigDiff = -sigDiff;
      }

      shiftDist = count_leading_zeros(32, sigDiff) - 8;
      expZ = expA - shiftDist;

      if ($signed(expZ) < 16's0) {
        shiftDist = expA;
        expZ       = 0;
      }

      return packToF32UI(signZ, expZ, sigDiff << shiftDist);

    } else {
      # when difference in exponents are not zero
      signZ = signF32UI(a);
      sigA = sigA << 7;
      sigB = sigB << 7;
      if ($signed(expDiff) < 0s) {
        signZ = ~signZ;
        if (expB == 0xFF) {
          if (sigB != 0) {
            return SP_CANONICAL_NAN;
          }
          return packToF32UI(signZ, expB, 0);
        }
        expZ = expB - 1;
        sigX = sigB | 32'h40000000;
        sigY = sigA + ((expA != 0) ? 32'h40000000 : sigA);
        expDiff = - expDiff;
      } else {
        if (expA == 0xFF) {
          if (sigA != 0) {
            return SP_CANONICAL_NAN;
          }
          return a;
        }
        expZ = expA - 1;
        sigX = sigA | 32'h40000000;
        sigY = sigB + ((expB != 0) ? 32'h40000000 : sigB);
      }
      return softfloat_normRoundPackToF32(signZ, expZ, sigX - softfloat_shiftRightJam32(sigY, expDiff), mode);
    }
  }
}

function f32_add {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns sum of 2 floating point numbers
  }
  body {
    U32 a_xor_b = a ^ b;
    if (signF32UI(a_xor_b) == 1) {
      # subtract if signs are different
      return softfloat_subMagsF32(a,b,mode);
    } else {
      # add if signs are the same
      return softfloat_addMagsF32(a,b,mode);
    }
  }
}

function f32_sub {
  returns U32
  arguments
    U32 a,
    U32 b,
    RoundingMode mode
  description {
    Returns difference of 2 floating point numbers
  }
  body {
    U32 a_xor_b = a ^ b;
    if (signF32UI(a_xor_b) == 1) {
      # add if signs are different
      return softfloat_addMagsF32(a,b,mode);
    } else {
      # subtract if signs are the same
      return softfloat_subMagsF32(a,b,mode);
    }
  }
}

function i32_to_f32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit signed integer to 32-bit floating point number
  }
  body {
    # sign of integer, it is 1 when negative
    Bits<1> sign = a[31];
    if ((a & 0x7FFFFFFF) == 0) {
      return (sign == 1) ? packToF32UI(1, 0x9E, 0) : packToF32UI(0, 0, 0);
    }
    U32 absA = (sign == 1) ? -a : a;
    return softfloat_normRoundPackToF32(sign, 0x9C, absA, mode);
  }
}

function ui32_to_f32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit unsigned integer to 32-bit floating point number
  }
  body {
    # sign of integer, it is 1 when negative
    if (a == 0) {
      return a;
    }
    if (a[31] == 1) {
      return softfloat_roundPackToF32(0, 0x9D, a>>1 | (a & 1), mode);
    } else {
      return softfloat_normRoundPackToF32(0, 0x9C, a, mode);
    }
  }
}

function f32_to_i32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to a signed 32-bit integer
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);
    Bits<16> shiftDist;
    U64 sig64;
    # for NaN return the highest positive value and set floating-point flag to invalid.
    if ((exp == 8'hFF) && (sig != 0)) {
      sign = 0;
      set_fp_flag(FpFlag::NV);
      return I32_NAN;
    }

    # MSB of significand is set to 1 because minimum 32-bit integer in IEEE 754 is 32'h80000000
    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 32;
    shiftDist = 8'hAA - exp;

    if ($signed(shiftDist) > 0s) {
      sig64 = softfloat_shiftRightJam64( sig64, shiftDist);
    }

    return softfloat_roundToI32(sign, sig64, mode);
  }
}

function f32_to_ui32 {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to an unsigned 32-bit integer
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> sig = fracF32UI(a);
    Bits<16> shiftDist;
    U64 sig64;
    # for NaN return the highest positive value and set floating-point flag to invalid.
    if ((exp == 8'hFF) && (sig != 0)) {
      sign = 0;
      set_fp_flag(FpFlag::NV);
      return UI32_NAN;
    }

    # MSB of significand is set to 1 because minimum 32-bit integer in IEEE 754 is 32'h80000000
    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 32;
    shiftDist = 8'hAA - exp;

    if ($signed(shiftDist) > 0s) {
      sig64 = softfloat_shiftRightJam64( sig64, shiftDist);
    }

    return softfloat_roundToUI32(sign, sig64, mode);
  }
}

function softfloat_roundPackToF32_no_flag {
  returns Bits<32>     # single precision value
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Round FP value according to +mdode+ and then pack it in IEEE format.
    No flags to be set
  }
  body {
    Bits<8> roundIncrement = 0x40;
    if ( (mode != RoundingMode::RNE) && (mode != RoundingMode::RMM)) {
      roundIncrement =
        (mode == ((sign != 0) ? RoundingMode::RDN : RoundingMode::RUP))
          ? 0x7F
          : 0;
    }
    Bits<8> roundBits = sig & 0x7f;

    if ( 0xFD <= exp ) {
      if ($signed(exp) < 's0) {
        Boolean isTiny =
          ($signed(exp) < -8's1) || (sig + roundIncrement < 0x80000000);
        sig = softfloat_shiftRightJam32( sig, -exp );
        exp = 0;
        roundBits = sig & 0x7F;
      } else if ('shFD < $signed(exp) || (0x80000000 <= sig + roundIncrement)) {
        return packToF32UI(sign, 0xFF, 0) - ((roundIncrement == 0) ? 1 : 0);
      }
    }

    sig = (sig + roundIncrement) >> 7;
    sig = sig & ~((roundBits ^ 0x40) & ((mode == RoundingMode::RNE) ? 1 : 0));
    if ( sig == 0 ) {
      exp = 0;
    }
    return packToF32UI(sign, exp, sig);
  }
}

function softfloat_normRoundPackToF32_no_flag {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<32> sig,
    RoundingMode mode
  description {
    Normalize, round, and pack into a 32-bit floating point value
    No flags to be set
  }
  body {
    Bits<8> shiftDist = count_leading_zeros(32, sig) - 1;
    exp = exp - shiftDist;
    if ((7 <= shiftDist) && (exp < 0xFD)) {
      return packToF32UI(sign, (sig != 0) ? exp : 0, sig << (shiftDist - 7));
    } else {
      return softfloat_roundPackToF32_no_flag(sign, exp, sig << shiftDist, mode);
    }
  }
}

function i32_to_f32_no_flag {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit signed integer to 32-bit floating point number
    No flags to be set
  }
  body {
    # sign of integer, it is 1 when negative
    Bits<1> sign = a[31];
    if ((a & 0x7FFFFFFF) == 0) {
      return (sign == 1) ? packToF32UI(1, 0x9E, 0) : packToF32UI(0, 0, 0);
    }
    U32 magnitude_of_A = returnMag(a);
    return softfloat_normRoundPackToF32_no_flag(sign, 0x9C, magnitude_of_A, mode);
  }
}

function softfloat_roundToI32_no_flag {
  returns Bits<32>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    RoundingMode roundingMode
  description {
    Round to signed 32-bit integer, using +rounding_mode+
    No flag to be set
  }
  body {
    Bits<16> roundIncrement = 0x800;
    if (
      (roundingMode != RoundingMode::RMM)
      && (roundingMode != RoundingMode::RNE)
    ) {
      roundIncrement = 0;
      if (
        sign == 1
          ? (roundingMode == RoundingMode::RDN)
          : (roundingMode == RoundingMode::RUP)
      ) {
        roundIncrement = 0xFFF;
      }
    }
    Bits<16> roundBits = sig & 0xFFF;
    sig = sig + roundIncrement;
    if ((sig & 0xFFFFF00000000000) != 0) {
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    Bits<32> sig32 = sig >> 12;
    if (
      (roundBits == 0x800 && (roundingMode == RoundingMode::RNE))
    ) {
      sig32 = sig32 & ~32'b1;
    }

    Bits<32> z = (sign == 1) ? -sig32 : sig32;
    if ((z != 0) && (($signed(z) < 's0) != (sign == 1))) {
      return sign == 1 ? WORD_NEG_OVERFLOW : WORD_POS_OVERFLOW;
    }

    return z;
  }
}

function f32_to_i32_no_flag {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Converts 32-bit floating point number to a signed 32-bit integer
    No flags to be set
  }
  body {
    Bits<1> sign = signF32UI(a);
    Bits<8> exp  = expF32UI(a);
    Bits<23> sig = fracF32UI(a);
    Bits<8> shiftDist;
    U64 sig64;
    # for NaN return the highest positive value and set floating-point flag to invalid.
    if ((exp == 8'hFF) && (sig != 0)) {
      sign = 0;
      return I32_NAN;
    }

    # MSB of significand is set to 1 because minimum 32-bit integer in IEEE 754 is 32'h80000000
    if (exp != 0) {
      sig = sig | 32'h00800000;
    }

    sig64 = sig `<< 32;
    shiftDist = 8'hAA - exp;

    if (shiftDist > 0) {
      sig64 = softfloat_shiftRightJam64( sig64, shiftDist);
    }

    return softfloat_roundToI32_no_flag(sign, sig64, mode);
  }
}

function round_f32_to_integral {
  returns U32
  arguments
    U32 a,
    RoundingMode mode
  description {
    Rounds 32-bit floating point number to a signed 32-bit integer.
    This 32-bit integer is represented as a floating point number and returned.
  }
  body {
    if ((is_sp_neg_inf?(a)) || (is_sp_pos_inf?(a)) || (is_sp_pos_zero?(a)) || (is_sp_neg_zero?(a))) {
      # Return zero or infinity respectively for zero or infinity inputs
      return a;
    } else if (is_sp_signaling_nan?(a)) {
      # set invalid flag for signaling NaN
      set_fp_flag(FpFlag::NV);
      return a;
    } else if (is_sp_nan?(a)) {
      # quiet NaN: return unchanged without modifying flags
      return a;
    }
    # If magnitude is already an integer (exp >= 0x96, i.e. |value| >= 2^23),
    # the value has no fractional bits and must be returned unchanged.
    Bits<8> exp = expF32UI(a);
    if (exp >= 8'h96) {
      return a;
    }
    # intermediate variable for storing 32-bit rounded integer
    U32 intermediate;
    # round 32-bit floating point number to integer, no flags to be set
    intermediate = f32_to_i32_no_flag(a, mode);
    # represent the integer as floating point number
    return i32_to_f32_no_flag(intermediate, mode);
  }
}

function round_f64_to_integral {
  returns Bits<64>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Rounds a double-precision floating-point number to an integer-valued double.
    Zero and infinity inputs are returned unchanged. Signaling NaN sets NV and
    returns the input. Mirrors round_f32_to_integral using f64_to_i64 internals.
  }
  body {
    if (is_dp_neg_inf?(a) || is_dp_pos_inf?(a) || is_dp_pos_zero?(a) || is_dp_neg_zero?(a)) {
      return a;
    } else if (is_dp_signaling_nan?(a)) {
      set_fp_flag(FpFlag::NV);
      return a;
    } else if (is_dp_nan?(a)) {
      return a;
    }
    # If the magnitude is large enough that it is already an integer
    # (|exp| >= 52 means no fractional bits), return unchanged.
    Bits<16> exp = expF64UI(a);
    if (exp >= 16'h433) {
      return a;
    }
    # Convert to i64 without flags, then back to f64 without flags.
    Bits<64> int_val = f64_to_i64_no_flag(a, mode);
    return i64_to_f64_no_flag(int_val);
  }
}

struct ExpAndSig {
  Bits<16> exp;
  Bits<32> sig;
}

function softfloat_normSubnormalF32Sig {
  returns ExpAndSig
  arguments
    Bits<32> sig
  description {
    Normalize a subnormal F32 significand.
    Returns (exp, sig32) where exp is the adjusted exponent (two's complement
    in Bits<16>) and sig32 is the normalized significand with implicit leading 1
    at bit 23. The exponent is widened to Bits<16> (rather than the natural
    Bits<8>) so that callers can add two adjusted exponents together (e.g.
    expA + expB - bias) without overflow.
  }
  body {
    Bits<16> shiftDist = count_leading_zeros(32, sig) - 8;
    ExpAndSig ret;
    ret.exp = 1 - shiftDist;
    ret.sig = sig << shiftDist;
    return ret;
  }
}

function softfloat_shortShiftRightJam64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<8> dist
  description {
    Shifts +a+ right by +dist+ bits (dist must be in 1..31), jamming any
    shifted-off bits into the least-significant bit of the result.
  }
  body {
    return a >> dist | (((a & ((64'h1 << dist) - 1)) != 0) ? 1 : 0);
  }
}

function softfloat_roundToI64 {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    Bits<64> sigExtra,
    RoundingMode roundingMode
  description {
    Round to signed 64-bit integer, using +roundingMode+.
    Translated from Berkeley Softfloat softfloat_roundToI64.
  }
  body {
    Bits<64> z;
    Boolean needs_increment = false;

    if ((roundingMode == RoundingMode::RMM) || (roundingMode == RoundingMode::RNE)) {
      if (64'h8000000000000000 <= sigExtra) {
        needs_increment = true;
      }
    } else {
      if ((sigExtra != 0) && ((sign != 0) ? (roundingMode == RoundingMode::RDN) : (roundingMode == RoundingMode::RUP))) {
        needs_increment = true;
      }
    }

    if (needs_increment) {
      sig = sig + 1;
      if (sig == 0) {
        set_fp_flag(FpFlag::NV);
        return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
      }
      if ((sigExtra == 64'h8000000000000000) && (roundingMode == RoundingMode::RNE)) {
        sig = sig & ~64'h1;
      }
    }

    z = (sign == 1) ? -sig : sig;
    if ((z != 0) && (((($signed(z) < 0s) ? 1 : 0) ^ sign) == 1)) {
      set_fp_flag(FpFlag::NV);
      return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
    }

    if (sigExtra != 0) {
      set_fp_flag(FpFlag::NX);
    }

    return z;
  }
}

function softfloat_roundToI64_no_flag {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    Bits<64> sigExtra,
    RoundingMode roundingMode
  description {
    Round to signed 64-bit integer without setting any floating-point flags.
    Used by round_f64_to_integral where flags are managed by the caller.
  }
  body {
    Boolean needs_increment = false;
    if ((roundingMode == RoundingMode::RMM) || (roundingMode == RoundingMode::RNE)) {
      if (64'h8000000000000000 <= sigExtra) {
        needs_increment = true;
      }
    } else {
      if ((sigExtra != 0) && ((sign != 0) ? (roundingMode == RoundingMode::RDN) : (roundingMode == RoundingMode::RUP))) {
        needs_increment = true;
      }
    }
    if (needs_increment) {
      sig = sig + 1;
      if (sig == 0) {
        return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
      }
      if ((sigExtra == 64'h8000000000000000) && (roundingMode == RoundingMode::RNE)) {
        sig = sig & ~64'h1;
      }
    }
    Bits<64> z = (sign == 1) ? -sig : sig;
    if ((z != 0) && (((($signed(z) < 0s) ? 1 : 0) ^ sign) == 1)) {
      return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
    }
    return z;
  }
}

function softfloat_roundToUI64 {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<64> sig,
    Bits<64> sigExtra,
    RoundingMode roundingMode
  description {
    Round to unsigned 64-bit integer, using +roundingMode+.
    Translated from Berkeley Softfloat softfloat_roundToUI64.
  }
  body {
    Boolean needs_increment = false;

    if ((roundingMode == RoundingMode::RMM) || (roundingMode == RoundingMode::RNE)) {
      if (64'h8000000000000000 <= sigExtra) {
        needs_increment = true;
      }
    } else {
      if (sign != 0) {
        if ((sig | sigExtra) == 0) {
          return 0;
        }
        if (roundingMode == RoundingMode::RDN) {
          set_fp_flag(FpFlag::NV);
          if (sign == 1) {
            return UI64_NEG_OVERFLOW;
          } else {
            return UI64_POS_OVERFLOW;
          }
        }
      } else {
        if ( (roundingMode == RoundingMode::RUP) && (sigExtra != 0)) {
          needs_increment = true;
        }
      }
    }

    if (needs_increment) {
      sig = sig + 1;
      if (sig == 0) {
        set_fp_flag(FpFlag::NV);
        if (sign == 1) {
          return UI64_NEG_OVERFLOW;
        } else {
          return UI64_POS_OVERFLOW;
        }
      }
      if ( (sigExtra == 64'h8000000000000000) && (roundingMode == RoundingMode::RNE)) {
        sig = sig & ~64'h1;
      }
    }

    if ( (sign != 0) && (sig != 0) ) {
      set_fp_flag(FpFlag::NV);
      if (sign == 1) {
        return UI64_NEG_OVERFLOW;
      } else {
        return UI64_POS_OVERFLOW;
      }
    }

    if (sigExtra != 0) {
      set_fp_flag(FpFlag::NX);
    }
    return sig;
  }
}

function f32_lt? {
  returns Boolean
  arguments
    Bits<32> a,
    Bits<32> b,
    Boolean quiet
  description {
    Single-precision less-than comparison. Sets NV on any NaN unless +quiet+ is
    true (then only signaling NaN sets NV). Returns false for NaN operands.
    Mirrors the scalar flt.s ordering logic (sign-aware integer comparison).
  }
  body {
    if (is_sp_nan?(a) || is_sp_nan?(b)) {
      if (!quiet || is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
        set_fp_flag(FpFlag::NV);
      }
      return false;
    }
    Bits<1> sign_a = a[31];
    Bits<1> sign_b = b[31];
    if (sign_a != sign_b) {
      return (sign_a == 1) && ((a[30:0] | b[30:0]) != 0);
    } else {
      return (a != b) && ((sign_a ^ ((a < b) ? 1 : 0)) != 0);
    }
  }
}

function f32_le? {
  returns Boolean
  arguments
    Bits<32> a,
    Bits<32> b,
    Boolean quiet
  description {
    Single-precision less-than-or-equal comparison. Sets NV on any NaN unless
    +quiet+ (then only signaling NaN). Returns false for NaN operands.
    Mirrors the scalar fle.s ordering logic.
  }
  body {
    if (is_sp_nan?(a) || is_sp_nan?(b)) {
      if (!quiet || is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
        set_fp_flag(FpFlag::NV);
      }
      return false;
    }
    Bits<1> sign_a = a[31];
    Bits<1> sign_b = b[31];
    if (sign_a != sign_b) {
      return (sign_a == 1) || ((a[30:0] | b[30:0]) == 0);
    } else {
      return (a == b) || ((sign_a ^ ((a < b) ? 1 : 0)) == 1);
    }
  }
}

function f32_eq? {
  returns Boolean
  arguments
    Bits<32> a,
    Bits<32> b,
    Boolean quiet
  description {
    Single-precision equality comparison. Quiet form (vmfeq/vmfne) sets NV only
    on signaling NaN; non-quiet form sets NV on any NaN. Returns false for NaN.
    +0.0 equals -0.0. Mirrors scalar feq.s.
  }
  body {
    if (is_sp_nan?(a) || is_sp_nan?(b)) {
      if (!quiet || is_sp_signaling_nan?(a) || is_sp_signaling_nan?(b)) {
        set_fp_flag(FpFlag::NV);
      }
      return false;
    }
    return (a == b) || ((a | b)[30:0] == 0);
  }
}

function f32_classify {
  returns Bits<32>
  arguments
    Bits<32> a
  description {
    Returns the 10-bit one-hot IEEE class of a single-precision value, matching
    the fclass.s bit assignment. Mirrors the scalar fclass.s classification.
  }
  body {
    if (is_sp_neg_inf?(a))          { return 32'h001; }
    else if (is_sp_neg_norm?(a))    { return 32'h002; }
    else if (is_sp_neg_subnorm?(a)) { return 32'h004; }
    else if (is_sp_neg_zero?(a))    { return 32'h008; }
    else if (is_sp_pos_zero?(a))    { return 32'h010; }
    else if (is_sp_pos_subnorm?(a)) { return 32'h020; }
    else if (is_sp_pos_norm?(a))    { return 32'h040; }
    else if (is_sp_pos_inf?(a))     { return 32'h080; }
    else if (is_sp_signaling_nan?(a)) { return 32'h100; }
    else { return 32'h200; }
  }
}

# ============================================================================
# Double-precision (f64) SoftFloat pipeline.
# Adapted from berkeley-softfloat-3 by John R. Hauser (BSD-3-Clause), mirroring
# the f32 routines above. f64: 1 sign bit, 11-bit exponent (bias 0x3FF,
# all-ones 0x7FF), 52-bit significand. Intermediate exponents use Bits<16> for
# two's-complement headroom, matching the f32 convention.
# ============================================================================

function signF64UI {
  returns Bits<1>
  arguments
    Bits<64> a
  description {
    Extract sign-bit of a 64-bit floating point number.
  }
  body {
    return a[63];
  }
}

function expF64UI {
  returns Bits<11>
  arguments
    Bits<64> a
  description {
    Extract exponent of a 64-bit floating point number.
  }
  body {
    return a[62:52];
  }
}

function fracF64UI {
  returns Bits<52>
  arguments
    Bits<64> a
  description {
    Extract significand of a 64-bit floating point number.
  }
  body {
    return a[51:0];
  }
}

function packToF64UI {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<11> exp,
    Bits<64> sig
  description {
    Pack components into a 64-bit value.
  }
  body {
    return (sign `<< 63) + (exp `<< 52) + sig;
  }
}

struct ExpAndSig64 {
  Bits<16> exp;
  Bits<64> sig;
}

function softfloat_normSubnormalF64Sig {
  returns ExpAndSig64
  arguments
    Bits<64> sig
  description {
    Normalize a subnormal F64 significand.
    Returns (exp, sig64) where exp is the adjusted exponent (two's complement
    in Bits<16>) and sig64 is the normalized significand with the implicit
    leading 1 at bit 52.
  }
  body {
    Bits<8> shiftDist = count_leading_zeros_64(64, sig) - 11;
    ExpAndSig64 ret;
    ret.exp = 1 - shiftDist;
    ret.sig = sig << shiftDist;
    return ret;
  }
}

function softfloat_roundPackToF64 {
  returns Bits<64>     # double precision value
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<64> sig,
    RoundingMode mode
  description {
    Round an F64 value according to +mode+ and then pack it in IEEE format.
    The +sig+ has the rounding bits in its low 10 bits (guard/round/sticky
    region), with the significand aligned so that the units bit is bit 10.
  }
  body {
    Bits<16> roundIncrement = 0x200;
    if ( (mode != RoundingMode::RNE) && (mode != RoundingMode::RMM)) {
      roundIncrement =
        (mode == ((sign != 0) ? RoundingMode::RDN : RoundingMode::RUP))
          ? 0x3FF
          : 0;
    }
    Bits<16> roundBits = sig & 0x3FF;

    if ( 0x7FD <= exp ) {
      if ($signed(exp) < 's0) {
        Boolean isTiny =
          ($signed(exp) < -16's1) || (sig + roundIncrement < 64'h8000000000000000);
        sig = softfloat_shiftRightJam64( sig, -exp );
        exp = 0;
        roundBits = sig & 0x3FF;
        if (isTiny && (roundBits != 0)) {
          set_fp_flag(FpFlag::UF);
        }
      } else if ((16'sh7FD < $signed(exp)) || (64'h8000000000000000 <= sig + roundIncrement)) {
        set_fp_flag(FpFlag::OF);
        set_fp_flag(FpFlag::NX);
        return packToF64UI(sign, 0x7FF, 0) - ((roundIncrement == 0) ? 1 : 0);
      }
    }

    sig = (sig + roundIncrement) >> 10;
    if (roundBits != 0) {
      set_fp_flag(FpFlag::NX);
      if (mode == RoundingMode::ROD) {
        sig = sig | 64'b1;
        return packToF64UI(sign, exp, sig);
      }
    }
    if ((roundBits == 0x200) && (mode == RoundingMode::RNE)) {
      sig = sig & ~64'b1;  # Clear only the LSB
    }
    if ( sig == 0 ) {
      exp = 0;
    }
    return packToF64UI(sign, exp, sig);
  }
}

function softfloat_normRoundPackToF64 {
  returns Bits<64>
  arguments
    Bits<1> sign,
    Bits<16> exp,
    Bits<64> sig,
    RoundingMode mode
  description {
    Normalize, round, and pack into a 64-bit floating point value.
  }
  body {
    Bits<8> shiftDist = count_leading_zeros_64(64, sig) - 1;
    exp = exp - shiftDist;
    if ((10 <= shiftDist) && (exp < 0x7FD)) {
      return packToF64UI(sign, (sig != 0) ? exp : 0, sig << (shiftDist - 10));
    } else {
      return softfloat_roundPackToF64(sign, exp, sig << shiftDist, mode);
    }
  }
}

function softfloat_addMagsF64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b,
    RoundingMode mode
  description {
    Returns the sum of the magnitudes of two f64 numbers.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
    Bits<16> expA = expF64UI(a);
    Bits<64> sigA = fracF64UI(a);
    Bits<16> expB = expF64UI(b);
    Bits<64> sigB = fracF64UI(b);

    Bits<64> sigZ;
    Bits<1>  signZ;
    Bits<16> expZ;

    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {
      if (expA == 11'd0) {
        return a + b; # both subnormal/zero: exponent fields align, add raw
      }
      # A is Inf or NaN when exponent is all-ones
      if (expA == 11'h7FF) {
        if ((sigA != 0) || (sigB != 0)) {
          if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
          return DP_CANONICAL_NAN;
        }
        return a; # infinity
      }
      signZ = signF64UI(a);
      expZ  = expA;
      sigZ  = 64'h0020000000000000 + sigA + sigB;
      if (((sigZ & 0x1) == 0) && (expZ < 11'h7FE)) {
        sigZ = sigZ >> 1;
        return packToF64UI(signZ, expZ[10:0], sigZ);
      }
      sigZ = sigZ << 9;
    } else {
      signZ = signF64UI(a);
      sigA = sigA << 9;
      sigB = sigB << 9;
      if ($signed(expDiff) < 16's0) {
        if (expB == 11'h7FF) {
          if (sigB != 0) {
            if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
            return DP_CANONICAL_NAN;
          }
          return packToF64UI(signZ, 11'h7FF, 0);
        }
        expZ = expB;
        sigA = (expA == 0) ? (2 * sigA) : (sigA + 64'h2000000000000000);
        sigA = softfloat_shiftRightJam64(sigA, -expDiff);
      } else {
        if (expA == 11'h7FF) {
          if (sigA != 0) {
            if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
            return DP_CANONICAL_NAN;
          }
          return a;
        }
        expZ = expA;
        sigB = (expB == 0) ? (2 * sigB) : (sigB + 64'h2000000000000000);
        sigB = softfloat_shiftRightJam64(sigB, expDiff);
      }
      sigZ = 64'h2000000000000000 + sigA + sigB;
      if ( sigZ < 64'h4000000000000000 ) {
        expZ = expZ - 1;
        sigZ = sigZ << 1;
      }
    }
    return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
  }
}

function softfloat_subMagsF64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b,
    RoundingMode mode
  description {
    Returns the difference of the magnitudes of two f64 numbers.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
    Bits<16> expA = expF64UI(a);
    Bits<64> sigA = fracF64UI(a);
    Bits<16> expB = expF64UI(b);
    Bits<64> sigB = fracF64UI(b);

    Bits<1>  signZ;
    Bits<16> expZ;
    Bits<64> sigDiff;
    Bits<64> sigX;
    Bits<64> sigY;
    Bits<8>  shiftDist;

    Bits<16> expDiff = expA - expB;

    if (expDiff == 16'd0) {
      if (expA == 11'h7FF) {
        if ((sigA != 0) || (sigB != 0)) {
          if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
          return DP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::NV);   # inf - inf is always invalid
        return DP_CANONICAL_NAN;
      }

      sigDiff = sigA - sigB;
      if (sigDiff == 0) {
        return packToF64UI(((mode == RoundingMode::RDN) ? 1 : 0), 0, 0);
      }
      if (expA != 0) {
        expA = expA - 1;
      }
      signZ = signF64UI(a);
      if ($signed(sigDiff) < 64's0) {
        signZ = ~signZ;
        sigDiff = -sigDiff;
      }
      shiftDist = count_leading_zeros_64(64, sigDiff) - 11;
      expZ = expA - shiftDist;
      if ($signed(expZ) < 16's0) {
        shiftDist = expA;
        expZ = 0;
      }
      return packToF64UI(signZ, expZ[10:0], sigDiff << shiftDist);
    } else {
      signZ = signF64UI(a);
      sigA = sigA << 10;
      sigB = sigB << 10;
      if ($signed(expDiff) < 16's0) {
        signZ = ~signZ;
        if (expB == 11'h7FF) {
          if (sigB != 0) {
            if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
            return DP_CANONICAL_NAN;
          }
          return packToF64UI(signZ, 11'h7FF, 0);
        }
        expZ = expB - 1;
        sigX = sigB | 64'h4000000000000000;
        sigY = sigA + ((expA != 0) ? 64'h4000000000000000 : sigA);
        expDiff = -expDiff;
      } else {
        if (expA == 11'h7FF) {
          if (sigA != 0) {
            if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
            return DP_CANONICAL_NAN;
          }
          return a;
        }
        expZ = expA - 1;
        sigX = sigA | 64'h4000000000000000;
        sigY = sigB + ((expB != 0) ? 64'h4000000000000000 : sigB);
      }
      return softfloat_normRoundPackToF64(signZ, expZ, sigX - softfloat_shiftRightJam64(sigY, expDiff), mode);
    }
  }
}

function f64_add {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b,
    RoundingMode mode
  description {
    Returns the sum of two f64 numbers.
  }
  body {
    Bits<64> a_xor_b = a ^ b;
    if (signF64UI(a_xor_b) == 1) {
      return softfloat_subMagsF64(a, b, mode);
    } else {
      return softfloat_addMagsF64(a, b, mode);
    }
  }
}

function f64_sub {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b,
    RoundingMode mode
  description {
    Returns the difference of two f64 numbers.
  }
  body {
    Bits<64> a_xor_b = a ^ b;
    if (signF64UI(a_xor_b) == 1) {
      return softfloat_addMagsF64(a, b, mode);
    } else {
      return softfloat_subMagsF64(a, b, mode);
    }
  }
}

# Throwaway probe: proves Bits<128> significand products type-check and compile.
# Real f64_mul (with full special-case handling) replaces this later in 12A.
function f64_mul {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b,
    RoundingMode mode
  description {
    Multiplies two 64-bit floating point numbers.
    Translated from Berkeley Softfloat f64_mul.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
    Bits<1>  signA = signF64UI(a);
    Bits<16> expA  = expF64UI(a);
    Bits<64> sigA  = fracF64UI(a);
    Bits<1>  signB = signF64UI(b);
    Bits<16> expB  = expF64UI(b);
    Bits<64> sigB  = fracF64UI(b);
    Bits<1>  signZ = signA ^ signB;

    Bits<16> expZ;
    Bits<64> sigZ;

    if (expA == 16'h7FF) {
      if ((sigA != 0) || ((expB == 16'h7FF) && (sigB != 0))) {
        if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      if ((expB == 0) && (sigB == 0)) {
        set_fp_flag(FpFlag::NV);
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signZ, 11'h7FF, 0);
    }
    if (expB == 16'h7FF) {
      if (sigB != 0) {
        if (is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      if ((expA == 0) && (sigA == 0)) {
        set_fp_flag(FpFlag::NV);
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signZ, 11'h7FF, 0);
    }

    if (expA == 0) {
      if (sigA == 0) { return packToF64UI(signZ, 0, 0); }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    if (expB == 0) {
      if (sigB == 0) { return packToF64UI(signZ, 0, 0); }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    expZ = (expA + expB) - 16'h3FF;
    sigA = (sigA | 64'h0010000000000000) << 10;
    sigB = (sigB | 64'h0010000000000000) << 11;

    # 53-bit x 53-bit significand product needs 128 bits.
    Bits<128> prodA   = sigA;
    Bits<128> prodB   = sigB;
    Bits<128> sigProd = prodA * prodB;

    # sigZ = high 64 bits, with the low 64 bits jammed into the sticky LSB.
    sigZ = ((sigProd >> 64)[63:0]) | ((sigProd[63:0] != 0) ? 1 : 0);

    if (sigZ < 64'h4000000000000000) {
      expZ = expZ - 1;
      sigZ = sigZ << 1;
    }

    return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
  }
}

function f64_div {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b,
    RoundingMode mode
  description {
    Divides two 64-bit floating point numbers.
    Translated from Berkeley Softfloat f64_div. Uses the existing 32-bit
    reciprocal seed (softfloat_approxRecip32_1) plus a 64-bit Newton-Raphson
    refinement step, exactly as in Berkeley's f64_div.
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
    Bits<1>  signA = signF64UI(a);
    Bits<16> expA  = expF64UI(a);
    Bits<64> sigA  = fracF64UI(a);
    Bits<1>  signB = signF64UI(b);
    Bits<16> expB  = expF64UI(b);
    Bits<64> sigB  = fracF64UI(b);
    Bits<1>  signZ = signA ^ signB;

    Bits<16> expZ;

    if (expA == 16'h7FF) {
      if (sigA != 0) {
        if (is_dp_signaling_nan?(a)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      if (expB == 16'h7FF) {
        if (sigB != 0) {
          if (is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
          return DP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::NV);        # inf / inf
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signZ, 11'h7FF, 0);   # inf / finite = inf
    }
    if (expB == 16'h7FF) {
      if (sigB != 0) {
        if (is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      return packToF64UI(signZ, 0, 0);         # finite / inf = 0
    }

    if (expB == 0) {
      if (sigB == 0) {
        if ((expA == 0) && (sigA == 0)) {
          set_fp_flag(FpFlag::NV);      # 0 / 0
          return DP_CANONICAL_NAN;
        }
        set_fp_flag(FpFlag::DZ);        # x / 0 = inf
        return packToF64UI(signZ, 11'h7FF, 0);
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    if (expA == 0) {
      if (sigA == 0) { return packToF64UI(signZ, 0, 0); }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    expZ = ((expA - expB) + 16'h3FE);
    sigA = sigA | 64'h0010000000000000;
    sigB = sigB | 64'h0010000000000000;

    if (sigA < sigB) {
      expZ = expZ - 1;
      sigA = sigA << 11;
    } else {
      sigA = sigA << 10;
    }
    sigB = sigB << 11;

    # 32-bit reciprocal seed, refined to full width below.
    Bits<32> recip32 = softfloat_approxRecip32_1((sigB >> 32)[31:0]) - 2;
    Bits<32> sig32Z  = ((((sigA >> 32)[31:0]) `* recip32) >> 32)[31:0];

    # doubleTerm is uint32_t in Berkeley: compute at 32 bits, then zero-extend.
    Bits<64> doubleTerm = (sig32Z << 1);
    Bits<64> rem =
      (((sigA - (doubleTerm * ((sigB >> 32)[31:0]))) << 28)
        - (doubleTerm * ((sigB[31:0]) >> 4)));

    Bits<32> q = (((((rem >> 32)[31:0]) `* recip32) >> 32)[31:0]) + 4;

    # sig32Z and q are widened (via `<<) before combining, matching the
    # (uint_fast64_t) casts in Berkeley: no 32-bit truncation of the pieces.
    Bits<64> sigZ = ((sig32Z `<< 32) + (q `<< 4));

    if ((sigZ & 64'h1FF) < 64'h40) {
      q    = q & ~32'h7;
      sigZ = sigZ & ~64'h7F;
      doubleTerm = (q << 1);
      rem =
        (((rem - (doubleTerm * ((sigB >> 32)[31:0]))) << 28)
          - (doubleTerm * ((sigB[31:0]) >> 4)));
      if ((rem & 64'h8000000000000000) != 0) {
        sigZ = sigZ - 64'h80;
      } else {
        if (rem != 0) { sigZ = sigZ | 1; }
      }
    }

    return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
  }
}

function f64_sqrt {
  returns Bits<64>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Computes the square root of a 64-bit floating point number.
    Translated from Berkeley Softfloat f64_sqrt. Uses the existing 32-bit
    reciprocal-sqrt seed (softfloat_approxRecipSqrt32_1) plus a 64-bit
    refinement step, exactly as in Berkeley's f64_sqrt.
  }
  body {
    if (is_dp_signaling_nan?(a)) { set_fp_flag(FpFlag::NV); }
    Bits<1>  signA = signF64UI(a);
    Bits<16> expA  = expF64UI(a);
    Bits<64> sigA  = fracF64UI(a);

    if (expA == 16'h7FF) {
      if (sigA != 0) {
        if (is_dp_signaling_nan?(a)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      if (signA == 0) { return a; }        # sqrt(+inf) = +inf
      set_fp_flag(FpFlag::NV);             # sqrt(-inf)
      return DP_CANONICAL_NAN;
    }
    if (signA == 1) {
      if ((expA == 0) && (sigA == 0)) { return a; }   # sqrt(-0) = -0
      set_fp_flag(FpFlag::NV);            # sqrt(negative)
      return DP_CANONICAL_NAN;
    }
    if (expA == 0) {
      if (sigA == 0) { return a; }         # sqrt(+0) = +0
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    # Exponent halving. Uses arithmetic shift (>>>), because (expA - bias)
    # is negative for arguments < 1.0.
    Bits<16> expZ = (((expA - 16'h3FF) >>> 1) + 16'h3FE);
    Bits<1>  oddExpA = expA[0];

    sigA = sigA | 64'h0010000000000000;
    Bits<32> sig32A      = (sigA >> 21)[31:0];
    Bits<32> recipSqrt32 = softfloat_approxRecipSqrt32_1(oddExpA, sig32A);
    Bits<32> sig32Z      = ((sig32A `* recipSqrt32) >> 32)[31:0];

    if (oddExpA == 1) {
      sigA   = sigA << 8;
      sig32Z = sig32Z >> 1;
    } else {
      sigA = sigA << 9;
    }

    Bits<64> rem = (sigA - (sig32Z `* sig32Z));
    Bits<32> q   = ((((rem >> 2)[31:0]) `* recipSqrt32) >> 32)[31:0];
    Bits<64> sigZ = (((sig32Z `<< 32) | 64'h20) + (q `<< 3));

    if ((sigZ & 64'h1FF) < 64'h22) {
      sigZ = sigZ & ~64'h3F;
      Bits<64> shiftedSigZ = sigZ >> 6;
      # sigA<<52 and the square wrap mod 2^64 on purpose (ordinary *, <<).
      rem = ((sigA << 52) - (shiftedSigZ * shiftedSigZ));
      if ((rem & 64'h8000000000000000) != 0) {
        sigZ = sigZ - 1;
      } else {
        if (rem != 0) { sigZ = sigZ | 1; }
      }
    }

    return softfloat_roundPackToF64(0, expZ, sigZ, mode);
  }
}



# ---- f64 classification predicates (mirror is_sp_* with 64-bit widths) ----

function is_dp_neg_inf? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Return true if +dp_value+ is negative infinity. }
  body { return dp_value == DP_NEG_INF; }
}

function is_dp_pos_inf? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Return true if +dp_value+ is positive infinity. }
  body { return dp_value == DP_POS_INF; }
}

function is_dp_neg_norm? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is a negative normal number. }
  body {
    return
      (dp_value[63] == 1)
      && (dp_value[62:52] != 11'b11111111111)
      && (dp_value[62:52] != 11'b00000000000);
  }
}

function is_dp_pos_norm? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is a positive normal number. }
  body {
    return
      (dp_value[63] == 0)
      && (dp_value[62:52] != 11'b11111111111)
      && (dp_value[62:52] != 11'b00000000000);
  }
}

function is_dp_neg_subnorm? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is a negative subnormal number. }
  body {
    return
      (dp_value[63] == 1)
      && (dp_value[62:52] == 0)
      && (dp_value[51:0] != 0);
  }
}

function is_dp_pos_subnorm? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is a positive subnormal number. }
  body {
    return
      (dp_value[63] == 0)
      && (dp_value[62:52] == 0)
      && (dp_value[51:0] != 0);
  }
}

function is_dp_neg_zero? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is negative zero. }
  body { return dp_value == DP_NEG_ZERO; }
}

function is_dp_pos_zero? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is positive zero. }
  body { return dp_value == DP_POS_ZERO; }
}

function is_dp_nan? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is a NaN (quiet or signaling). }
  body {
    return
      (dp_value[62:52] == 11'b11111111111)
      && (dp_value[51:0] != 0);
  }
}

function is_dp_signaling_nan? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is a signaling NaN. }
  body {
    return
      (dp_value[62:52] == 11'b11111111111)
      && (dp_value[51] == 0)
      && (dp_value[50:0] != 0);
  }
}

function is_dp_quiet_nan? {
  returns Boolean
  arguments Bits<64> dp_value
  description { Returns true if +dp_value+ is a quiet NaN. }
  body {
    return
      (dp_value[62:52] == 11'b11111111111)
      && (dp_value[51] == 1);
  }
}

# ---- f64 comparisons (mirror f32_lt?/le?/eq? with 64-bit widths) ----

function f64_lt? {
  returns Boolean
  arguments
    Bits<64> a,
    Bits<64> b,
    Boolean quiet
  description {
    Double-precision less-than comparison. Sets NV on any NaN unless +quiet+ is
    true (then only signaling NaN sets NV). Returns false for NaN operands.
  }
  body {
    if (is_dp_nan?(a) || is_dp_nan?(b)) {
      if (!quiet || is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) {
        set_fp_flag(FpFlag::NV);
      }
      return false;
    }
    Bits<1> sign_a = a[63];
    Bits<1> sign_b = b[63];
    if (sign_a != sign_b) {
      return (sign_a == 1) && ((a[62:0] | b[62:0]) != 0);
    } else {
      return (a != b) && ((sign_a ^ ((a < b) ? 1 : 0)) != 0);
    }
  }
}

function f64_le? {
  returns Boolean
  arguments
    Bits<64> a,
    Bits<64> b,
    Boolean quiet
  description {
    Double-precision less-than-or-equal comparison. Sets NV on any NaN unless
    +quiet+ (then only signaling NaN). Returns false for NaN operands.
  }
  body {
    if (is_dp_nan?(a) || is_dp_nan?(b)) {
      if (!quiet || is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) {
        set_fp_flag(FpFlag::NV);
      }
      return false;
    }
    Bits<1> sign_a = a[63];
    Bits<1> sign_b = b[63];
    if (sign_a != sign_b) {
      return (sign_a == 1) || ((a[62:0] | b[62:0]) == 0);
    } else {
      return (a == b) || ((sign_a ^ ((a < b) ? 1 : 0)) == 1);
    }
  }
}

function f64_eq? {
  returns Boolean
  arguments
    Bits<64> a,
    Bits<64> b,
    Boolean quiet
  description {
    Double-precision equality comparison. Quiet form sets NV only on signaling
    NaN; non-quiet form sets NV on any NaN. Returns false for NaN. +0.0 == -0.0.
  }
  body {
    if (is_dp_nan?(a) || is_dp_nan?(b)) {
      if (!quiet || is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) {
        set_fp_flag(FpFlag::NV);
      }
      return false;
    }
    return (a == b) || ((a | b)[62:0] == 0);
  }
}

function f64_classify {
  returns Bits<64>
  arguments
    Bits<64> a
  description {
    Returns the 10-bit one-hot IEEE class of a double-precision value, matching
    the fclass.d bit assignment.
  }
  body {
    if (is_dp_neg_inf?(a))            { return 64'h001; }
    else if (is_dp_neg_norm?(a))      { return 64'h002; }
    else if (is_dp_neg_subnorm?(a))   { return 64'h004; }
    else if (is_dp_neg_zero?(a))      { return 64'h008; }
    else if (is_dp_pos_zero?(a))      { return 64'h010; }
    else if (is_dp_pos_subnorm?(a))   { return 64'h020; }
    else if (is_dp_pos_norm?(a))      { return 64'h040; }
    else if (is_dp_pos_inf?(a))       { return 64'h080; }
    else if (is_dp_signaling_nan?(a)) { return 64'h100; }
    else { return 64'h200; }
  }
}

# ---- f64 conversions (mirror f32 conversions with 64-bit widths) ----
# f64: exp bias 0x3FF; for f64->int alignment, Berkeley uses:
#   f64->i64/ui64:  shiftDist = 0x433 - exp   (0x433 = 1075 = 1023 + 52)
#   f64->i32/ui32:  shiftDist = 0x427 - exp   (0x427 = 1063), sig aligned in low bits

function f64_to_i64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts a 64-bit floating point number to a signed 64-bit integer.
    Translated from Berkeley Softfloat f64_to_i64.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    Bits<64> sig64;
    Bits<64> extra;

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }
    Bits<16> shiftDist = 16'h433 - exp;

    if ($signed(shiftDist) <= 0s) {
      # value >= 2^shift: may overflow. Berkeley shifts left (via 128-bit path).
      # shiftDist < -11  <=>  exp > 0x43E (0x433 + 11); use unsigned exp compare.
      if (exp > 16'h43E) {
        set_fp_flag(FpFlag::NV);
        if ((exp == 16'h7FF) && (fracF64UI(a) != 0)) {
          return I64_NAN;
        } else {
          return (sign == 1) ? I64_NEG_OVERFLOW : I64_POS_OVERFLOW;
        }
      }
      sig64 = sig << (-shiftDist);
      extra = 0;
    } else {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig, 0, shiftDist);
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToI64(sign, sig64, extra, mode);
  }
}

function f64_to_i64_no_flag {
  returns Bits<64>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts a 64-bit float to a signed 64-bit integer without setting flags.
    Used by round_f64_to_integral; caller guards NaN/inf/large-exp before calling.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);
    Bits<64> sig64;
    Bits<64> extra;
    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }
    Bits<16> shiftDist = 16'h433 - exp;
    if ($signed(shiftDist) <= 0s) {
      sig64 = sig << (-shiftDist);
      extra = 0;
    } else {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig, 0, shiftDist);
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToI64_no_flag(sign, sig64, extra, mode);
  }
}

function f64_to_ui64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts a 64-bit floating point number to an unsigned 64-bit integer.
    Translated from Berkeley Softfloat f64_to_ui64.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    Bits<64> sig64;
    Bits<64> extra;

    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }
    Bits<16> shiftDist = 16'h433 - exp;

    if ($signed(shiftDist) <= 0s) {
      # shiftDist < -11  <=>  exp > 0x43E; use unsigned exp compare.
      if (exp > 16'h43E) {
        set_fp_flag(FpFlag::NV);
        if ((exp == 16'h7FF) && (fracF64UI(a) != 0)) {
          return UI64_NAN;
        } else {
          return (sign == 1) ? UI64_NEG_OVERFLOW : UI64_POS_OVERFLOW;
        }
      }
      sig64 = sig << (-shiftDist);
      extra = 0;
    } else {
      TwoU64s sig64Extra = softfloat_shiftRightJam64Extra(sig, 0, shiftDist);
      sig64 = sig64Extra.u1;
      extra = sig64Extra.u2;
    }
    return softfloat_roundToUI64(sign, sig64, extra, mode);
  }
}

function f64_to_i32 {
  returns Bits<32>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts a 64-bit floating point number to a signed 32-bit integer.
    Translated from Berkeley Softfloat f64_to_i32.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if ((exp == 16'h7FF) && (sig != 0)) {
      sign = 0;
      set_fp_flag(FpFlag::NV);
      return I32_NAN;
    }
    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }
    # Align significand so units bit is at bit 12 (roundToI32 rounds low 12 bits).
    Bits<16> shiftDist = 16'h427 - exp;
    if ($signed(shiftDist) > 0s) {
      sig = softfloat_shiftRightJam64(sig, shiftDist);
    }
    return softfloat_roundToI32(sign, sig, mode);
  }
}

function f64_to_ui32 {
  returns Bits<32>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts a 64-bit floating point number to an unsigned 32-bit integer.
    Translated from Berkeley Softfloat f64_to_ui32.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> sig  = fracF64UI(a);

    if ((exp == 16'h7FF) && (sig != 0)) {
      sign = 0;
      set_fp_flag(FpFlag::NV);
      return UI32_NAN;
    }
    if (exp != 0) {
      sig = sig | 64'h0010000000000000;
    }
    Bits<16> shiftDist = 16'h427 - exp;
    if ($signed(shiftDist) > 0s) {
      sig = softfloat_shiftRightJam64(sig, shiftDist);
    }
    return softfloat_roundToUI32(sign, sig, mode);
  }
}

function i32_to_f64 {
  returns Bits<64>
  arguments
    Bits<32> a,
    RoundingMode mode
  description {
    Converts a 32-bit signed integer to a 64-bit floating point number.
    Exact (no rounding): every i32 is representable in f64's 52-bit significand.
  }
  body {
    if (a == 0) {
      return DP_POS_ZERO;
    }
    Bits<1>  sign = a[31];
    Bits<32> absA = (sign == 1) ? -a : a;
    # Berkeley: shiftDist = clz32(absA) + 21; packToF64UI(sign, 0x432 - shiftDist,
    # absA << shiftDist). The implicit 1 at bit 52 of sig64 carries into the
    # exponent field via packToF64UI's (exp<<52)+sig, so pass the FULL sig64
    # (masking to [51:0] would discard that carry and halve the result).
    Bits<8>  shiftDist = count_leading_zeros(32, absA) + 21;
    Bits<64> sig64 = {32'b0, absA} << shiftDist;
    Bits<11> exp = 11'h432 - shiftDist;
    return packToF64UI(sign, exp, sig64);
  }
}

function ui32_to_f64 {
  returns Bits<64>
  arguments
    Bits<32> a,
    RoundingMode mode
  description {
    Converts a 32-bit unsigned integer to a 64-bit floating point number.
    Exact (no rounding): every u32 is representable in f64's 52-bit significand.
  }
  body {
    if (a == 0) {
      return DP_POS_ZERO;
    }
    # Berkeley: shiftDist = clz32(a) + 21; pass full sig64 so the implicit bit
    # at position 52 carries into the exponent field (see i32_to_f64).
    Bits<8>  shiftDist = count_leading_zeros(32, a) + 21;
    Bits<64> sig64 = {32'b0, a} << shiftDist;
    Bits<11> exp = 11'h432 - shiftDist;
    return packToF64UI(0, exp, sig64);
  }
}

function i64_to_f64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts a 64-bit signed integer to a 64-bit floating point number.
    Translated from Berkeley Softfloat i64_to_f64.
  }
  body {
    Bits<1> sign = a[63];
    # a & 0x7FFF... == 0 means a is 0 (-> +0) or exactly -2^63 (-> packed const).
    if ((a & 64'h7FFFFFFFFFFFFFFF) == 0) {
      return (sign == 1) ? packToF64UI(1, 11'h43E, 0) : DP_POS_ZERO;
    }
    Bits<64> absA = (sign == 1) ? -a : a;
    return softfloat_normRoundPackToF64(sign, 16'h43C, absA, mode);
  }
}

function i64_to_f64_no_flag {
  returns Bits<64>
  arguments
    Bits<64> a
  description {
    Converts a signed 64-bit integer to f64 using RNE, without setting flags.
    Rounding is inherently inexact for large integers (>2^53), but fround only
    needs flag-free conversion back to f64 after a flag-free int round.
  }
  body {
    if ((a & 64'h7FFFFFFFFFFFFFFF) == 0) {
      return (a[63] == 1) ? packToF64UI(1, 11'h43E, 0) : DP_POS_ZERO;
    }
    Bits<1>  sign = a[63];
    Bits<64> absA = (sign == 1) ? -a : a;
    return softfloat_normRoundPackToF64(sign, 16'h43C, absA, RoundingMode::RNE);
  }
}

function ui64_to_f64 {
  returns Bits<64>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Converts a 64-bit unsigned integer to a 64-bit floating point number.
    Translated from Berkeley Softfloat ui64_to_f64.
  }
  body {
    if (a == 0) {
      return DP_POS_ZERO;
    }
    if ((a & 64'h8000000000000000) != 0) {
      return softfloat_roundPackToF64(0, 16'h43D, softfloat_shortShiftRightJam64(a, 1), mode);
    } else {
      return softfloat_normRoundPackToF64(0, 16'h43C, a, mode);
    }
  }
}

function f32_to_f64 {
  returns Bits<64>
  arguments
    Bits<32> a,
    RoundingMode mode
  description {
    Widens a 32-bit float to a 64-bit float. Exact for all normal/subnormal
    inputs. Translated from Berkeley Softfloat f32_to_f64.
  }
  body {
    Bits<1>  sign = signF32UI(a);
    Bits<16> exp  = expF32UI(a);
    Bits<32> frac = fracF32UI(a);

    if (exp == 8'hFF) {
      if (frac != 0) {
        # NaN -> canonical f64 NaN
        if (is_sp_signaling_nan?(a)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      # infinity
      return packToF64UI(sign, 11'h7FF, 0);
    }
    if (exp == 0) {
      if (frac == 0) {
        return packToF64UI(sign, 0, 0); # signed zero
      }
      # subnormal f32: normalize
      ExpAndSig norm = softfloat_normSubnormalF32Sig(frac);
      exp  = norm.exp;
      frac = norm.sig;
      # frac now has implicit 1 at bit 23; drop it after rebias
      Bits<64> sig64 = {41'b0, frac[22:0]} << 29;
      Bits<11> exp64 = 11'h380 + exp[10:0];   # 0x380 = 896 = 1023 - 127
      return packToF64UI(sign, exp64, sig64[51:0]);
    }
    # normal: rebias exponent (0x7F -> 0x3FF, delta 0x380) and left-align frac
    Bits<11> exp64 = 11'h380 + {3'b0, exp[7:0]};
    Bits<64> sig64 = {41'b0, frac[22:0]} << 29;
    return packToF64UI(sign, exp64, sig64[51:0]);
  }
}

function f64_to_f32 {
  returns Bits<32>
  arguments
    Bits<64> a,
    RoundingMode mode
  description {
    Narrows a 64-bit float to a 32-bit float, rounding per +mode+.
    Round-to-odd (RoundingMode::ROD) is supported for vfncvt.rod.f.f.w.
    Translated from Berkeley Softfloat f64_to_f32.
  }
  body {
    Bits<1>  sign = signF64UI(a);
    Bits<16> exp  = expF64UI(a);
    Bits<64> frac = fracF64UI(a);

    if (exp == 16'h7FF) {
      if (frac != 0) {
        if (is_dp_signaling_nan?(a)) { set_fp_flag(FpFlag::NV); }
        return SP_CANONICAL_NAN;
      }
      return packToF32UI(sign, 8'hFF, 0);
    }
    # Compress the 52-bit frac to 23 bits + sticky (jam low 29 bits into bit 0).
    Bits<32> frac32 = softfloat_shiftRightJam64(frac, 22)[31:0];
    if ((exp == 0) && (frac32 == 0)) {
      return packToF32UI(sign, 0, 0);
    }
    # rebias 0x3FF -> 0x7F (delta 0x380); subtract 1 for roundPack alignment
    Bits<16> exp32 = exp - 16'h380;
    return softfloat_roundPackToF32(sign, exp32 - 1, frac32 | 32'h40000000, mode);
  }
}

# ---- f64 fused multiply-add ----

enum F64MulAddOp {
  Softfloat_f64_mulAdd_addC    0 # (a * b) + c
  Softfloat_f64_mulAdd_subC    1 # (a * b) - c  (negate c)
  Softfloat_f64_mulAdd_subProd 2 # -(a * b) + c (negate product)
}

# Count leading zeros of a 128-bit value (no builtin exists for 128).
function count_leading_zeros_128 {
  returns XReg
  arguments
    Bits<128> value
  description {
    Number of leading zero bits of a 128-bit value, or 128 if value is zero.
  }
  body {
    Bits<64> hi = value[127:64];
    Bits<64> lo = value[63:0];
    if (hi != 0) {
      return count_leading_zeros_64(64, hi);
    } else {
      return 64 + count_leading_zeros_64(64, lo);
    }
  }
}

# 128-bit shift-right with jam (mirrors softfloat_shiftRightJam64 at 128 bits).
function softfloat_shiftRightJam128 {
  returns Bits<128>
  arguments
    Bits<128> a,
    Bits<32> dist
  description {
    Shifts +a+ right by +dist+ bits, jamming any shifted-off bits into the LSB.
    If +dist+ >= 128 the result is 0 or 1 depending on whether +a+ is nonzero.
  }
  body {
    return (dist < 127) ? ((a >> dist) | ((a[dist-1:0] != 0) ? 1 : 0)) : ((a != 0) ? 1 : 0);
  }
}

function f64_muladd {
  returns Bits<64>
  arguments
    Bits<64> a,
    Bits<64> b,
    Bits<64> c,
    F64MulAddOp op,
    RoundingMode mode
  description {
    Fused multiply-add for double-precision floats. Computes (a * b) + c with
    sign modifications based on op (addC / subC=negate c / subProd=negate
    product). Translated from Berkeley Softfloat softfloat_mulAddF64, using a
    128-bit product/accumulator (mirrors the f32 64-bit version scaled 2x).
  }
  body {
    if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b) || is_dp_signaling_nan?(c)) { set_fp_flag(FpFlag::NV); }
    Bits<1>  signA    = signF64UI(a);
    Bits<16> expA     = expF64UI(a);
    Bits<64> sigA     = fracF64UI(a);
    Bits<1>  signB    = signF64UI(b);
    Bits<16> expB     = expF64UI(b);
    Bits<64> sigB     = fracF64UI(b);
    Bits<1>  signC    = signF64UI(c) ^ ((op == F64MulAddOp::Softfloat_f64_mulAdd_subC) ? 1 : 0);
    Bits<16> expC     = expF64UI(c);
    Bits<64> sigC     = fracF64UI(c);
    Bits<1>  signProd = (signA ^ signB) ^ ((op == F64MulAddOp::Softfloat_f64_mulAdd_subProd) ? 1 : 0);

    Bits<64>  magBits;
    Bits<128> sig128Z;

    # Handle NaN/Inf in A
    if (expA == 16'h7FF) {
      if ((sigA != 0) || ((expB == 16'h7FF) && (sigB != 0))) {
        if (is_dp_signaling_nan?(a) || is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      magBits = expB | sigB;
      if (magBits != 0) {
        Bits<64> zA = packToF64UI(signProd, 11'h7FF, 0);
        if (expC != 16'h7FF) { return zA; }
        if (sigC != 0) {
          if (is_dp_signaling_nan?(c)) { set_fp_flag(FpFlag::NV); }
          return DP_CANONICAL_NAN;
        }
        if (signProd == signC) { return zA; }
      }
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in B
    if (expB == 16'h7FF) {
      if (sigB != 0) {
        if (is_dp_signaling_nan?(b)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      magBits = expA | sigA;
      if (magBits != 0) {
        Bits<64> zB = packToF64UI(signProd, 11'h7FF, 0);
        if (expC != 16'h7FF) { return zB; }
        if (sigC != 0) {
          if (is_dp_signaling_nan?(c)) { set_fp_flag(FpFlag::NV); }
          return DP_CANONICAL_NAN;
        }
        if (signProd == signC) { return zB; }
      }
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }

    # Handle NaN/Inf in C
    if (expC == 16'h7FF) {
      if (sigC != 0) {
        if (is_dp_signaling_nan?(c)) { set_fp_flag(FpFlag::NV); }
        return DP_CANONICAL_NAN;
      }
      return c;
    }

    # Handle zero/subnormal A
    if (expA == 0) {
      if (sigA == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF64UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return c;
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigA);
      expA = norm.exp;
      sigA = norm.sig;
    }

    # Handle zero/subnormal B
    if (expB == 0) {
      if (sigB == 0) {
        if (((expC | sigC) == 0) && (signProd != signC)) {
          return packToF64UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        return c;
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigB);
      expB = norm.exp;
      sigB = norm.sig;
    }

    # Compute product exponent and significand (128-bit product).
    Bits<16> expProd = expA + expB - 16'h03FE;
    sigA = (sigA | 64'h0010000000000000) << 10;
    sigB = (sigB | 64'h0010000000000000) << 10;
    Bits<128> prodA = sigA;
    Bits<128> prodB = sigB;
    Bits<128> sigProd = prodA * prodB;
    if (sigProd[125] == 0) {
      expProd = expProd - 1;
      sigProd = sigProd << 1;
    }
    Bits<1>  signZ = signProd;
    Bits<16> expZ;
    Bits<64> sigZ;

    # Handle zero/subnormal C
    if (expC == 0) {
      if (sigC == 0) {
        expZ = expProd - 1;
        sigZ = softfloat_shiftRightJam128(sigProd, 63)[63:0];
        return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
      }
      ExpAndSig64 norm = softfloat_normSubnormalF64Sig(sigC);
      expC = norm.exp;
      sigC = norm.sig;
    }
    sigC = (sigC | 64'h0010000000000000) << 9;

    Bits<16> expDiff = expProd - expC;

    if (signProd == signC) {
      # Same sign: add magnitudes
      if ($signed(expDiff) <= 0s) {
        expZ = expC;
        sig128Z = ({64'b0, sigC} << 64) + softfloat_shiftRightJam128(sigProd, -expDiff);
        sigZ = softfloat_shiftRightJam128(sig128Z, 64)[63:0];
      } else {
        expZ = expProd;
        sig128Z = sigProd + softfloat_shiftRightJam128({64'b0, sigC} << 64, expDiff);
        sigZ = softfloat_shiftRightJam128(sig128Z, 64)[63:0];
      }
      if (sigZ < 64'h4000000000000000) {
        expZ = expZ - 1;
        sigZ = sigZ << 1;
      }
      return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
    } else {
      # Different signs: subtract magnitudes
      Bits<128> sig128C = {64'b0, sigC} << 64;
      if ($signed(expDiff) < 0s) {
        signZ = signC;
        expZ = expC;
        sig128Z = sig128C - softfloat_shiftRightJam128(sigProd, -expDiff);
      } else if (expDiff == 0) {
        expZ = expProd;
        sig128Z = sigProd - sig128C;
        if (sig128Z == 0) {
          return packToF64UI((mode == RoundingMode::RDN) ? 1 : 0, 0, 0);
        }
        if (sig128Z[127] == 1) {
          signZ = signZ ^ 1;
          sig128Z = -sig128Z;
        }
      } else {
        expZ = expProd;
        sig128Z = sigProd - softfloat_shiftRightJam128(sig128C, expDiff);
      }
      Bits<8> shiftDist = count_leading_zeros_128(sig128Z) - 1;
      expZ = expZ - shiftDist;
      shiftDist = shiftDist - 8'h40;
      if ($signed(shiftDist) < 0s) {
        sigZ = softfloat_shiftRightJam128(sig128Z, -shiftDist)[63:0];
      } else {
        sigZ = (sig128Z << shiftDist)[63:0];
      }
      return softfloat_roundPackToF64(signZ, expZ, sigZ, mode);
    }
  }
}

# ============================================================================
# Phase 12E: 7-bit reciprocal and reciprocal-sqrt approximation functions.
# Translated from Sail riscv_f32Rsqrte7 / riscv_f32Recip7 (vext_fp_utils_insts.sail)
# and the inner rsqrt7 / recip7 algorithms. Tables from the RISC-V V spec §14.10-14.11.
# ============================================================================

# ---- 7-bit reciprocal-sqrt table (128 entries, from Sail rsqrt7 function) ----
Bits<8> vfrsqrt7_table[128] = [
  52, 51, 50, 48, 47, 46, 44, 43,
  42, 41, 40, 39, 38, 36, 35, 34,
  33, 32, 31, 30, 30, 29, 28, 27,
  26, 25, 24, 23, 23, 22, 21, 20,
  19, 19, 18, 17, 16, 16, 15, 14,
  14, 13, 12, 12, 11, 10, 10, 9,
  9, 8, 7, 7, 6, 6, 5, 4,
  4, 3, 3, 2, 2, 1, 1, 0,
  127, 125, 123, 121, 119, 118, 116, 114,
  113, 111, 109, 108, 106, 105, 103, 102,
  100, 99, 97, 96, 95, 93, 92, 91,
  90, 88, 87, 86, 85, 84, 83, 82,
  80, 79, 78, 77, 76, 75, 74, 73,
  72, 71, 70, 70, 69, 68, 67, 66,
  65, 64, 63, 63, 62, 61, 60, 59,
  59, 58, 57, 56, 56, 55, 54, 53
];

# ---- 7-bit reciprocal table (128 entries, from Sail recip7 function) ----
Bits<8> vfrec7_table[128] = [
  127, 125, 123, 121, 119, 117, 116, 114,
  112, 110, 109, 107, 105, 104, 102, 100,
  99, 97, 96, 94, 93, 91, 90, 88,
  87, 85, 84, 83, 81, 80, 79, 77,
  76, 75, 74, 72, 71, 70, 69, 68,
  66, 65, 64, 63, 62, 61, 60, 59,
  58, 57, 56, 55, 54, 53, 52, 51,
  50, 49, 48, 47, 46, 45, 44, 43,
  42, 41, 40, 40, 39, 38, 37, 36,
  35, 35, 34, 33, 32, 31, 31, 30,
  29, 28, 28, 27, 26, 25, 25, 24,
  23, 23, 22, 21, 21, 20, 19, 19,
  18, 17, 17, 16, 15, 15, 14, 14,
  13, 12, 12, 11, 11, 10, 9, 9,
  8, 8, 7, 7, 6, 5, 5, 4,
  4, 3, 3, 2, 2, 1, 1, 0
];

# 7-bit reciprocal-sqrt approximation for a single f32 element.
# Translated from Sail rsqrt7 (SEW=32 case) + riscv_f32Rsqrte7 special-case dispatch.
# Returns the 7-bit approximation of 1/sqrt(v); sets fflags on special cases.
function f32_rsqrt7 {
  returns Bits<32>
  arguments
    Bits<32> v,
    RoundingMode mode
  description {
    7-bit reciprocal-sqrt approximation per RISC-V V spec §14.11.
    Used by vfrsqrt7.v. Translated from Sail riscv_f32Rsqrte7 / rsqrt7.
  }
  body {
    # Special-case dispatch (Sail riscv_f32Rsqrte7)
    if (is_sp_signaling_nan?(v)) {
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }
    if (is_sp_nan?(v)) {
      return SP_CANONICAL_NAN;
    }
    if (v == SP_NEG_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return SP_NEG_INF;
    }
    if (v == SP_POS_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return SP_POS_INF;
    }
    if (v == SP_POS_INF) {
      return SP_POS_ZERO;
    }
    if (signF32UI(v) == 1) {
      # Negative normal or subnormal: invalid
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }

    # Inner rsqrt7 algorithm (Sail rsqrt7 for 'm=32, s=23, e=8)
    Bits<32> sig = {9'b0, v[22:0]};
    Bits<32> exp = {24'b0, v[30:23]};

    Boolean sub = (v[30:23] == 0);  # subnormal?

    # Initialize to normal-path values; overwrite if subnormal
    Bits<32> normalized_exp = exp;
    Bits<32> normalized_sig = sig;

    if (sub) {
      # Count leading zeros of the 23-bit significand
      Bits<8> nr_leadingzeros = count_leading_zeros(32, sig) - 9;
      normalized_exp = -(nr_leadingzeros `+ 0);
      normalized_sig = sig << (1 + nr_leadingzeros);
    }

    # Table index: [normalized_exp[0]] @ normalized_sig[22:17]
    # NOTE: Computed via bit-concatenation matching Sail exactly. Under
    # IGNOREUNDEFINED=YES in the ISS, the {exp[0]=1, sig_bits} concatenation
    # propagates as PossiblyUnknownBits through the table lookup, so odd-exponent
    # inputs cannot be ISS-validated without an ISS-level fix. This is a known
    # limitation — the odd-exponent path is validated via C reference model instead.
    # Arithmetic reformulation was tried but does not resolve the issue because the
    # ISS template system propagates PossiblyUnknown through all operations on
    # the argument, regardless of how the index is computed. ISS is not modified.
    Bits<7> idx = {normalized_exp[0], normalized_sig[22:17]};
    U32 tidx = idx;
    # Place top 7 bits of table value into bits 22:16 of 23-bit significand
    Bits<32> out_sig = {9'b0, vfrsqrt7_table[tidx][6:0], 16'b0};

    # Output exponent: (3*(2^(8-1)-1) - 1 - normalized_exp) / 2 = (3*127-1-exp)/2 = (380-exp)/2
    Bits<16> nexp16 = normalized_exp[15:0];
    Bits<16> out_exp16 = (16'h017C - nexp16) >> 1;
    Bits<8> out_exp = out_exp16[7:0];

    return {signF32UI(v), out_exp, out_sig[22:0]};
  }
}

# 7-bit reciprocal approximation for a single f32 element.
# Translated from Sail recip7 (SEW=32) + riscv_f32Recip7 special-case dispatch.
function f32_rec7 {
  returns Bits<32>
  arguments
    Bits<32> v,
    RoundingMode mode
  description {
    7-bit reciprocal approximation per RISC-V V spec §14.10.
    Used by vfrec7.v. Translated from Sail riscv_f32Recip7 / recip7.
  }
  body {
    # Special-case dispatch (Sail riscv_f32Recip7)
    if (is_sp_signaling_nan?(v)) {
      set_fp_flag(FpFlag::NV);
      return SP_CANONICAL_NAN;
    }
    if (is_sp_nan?(v)) {
      return SP_CANONICAL_NAN;
    }
    if (v == SP_NEG_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return SP_NEG_INF;
    }
    if (v == SP_POS_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return SP_POS_INF;
    }
    if (v == SP_NEG_INF) {
      return SP_NEG_ZERO;
    }
    if (v == SP_POS_INF) {
      return SP_POS_ZERO;
    }

    # Inner recip7 algorithm (Sail recip7 for 'm=32, s=23, e=8)
    Bits<32> sig = {9'b0, v[22:0]};
    Bits<32> exp = {24'b0, v[30:23]};
    Bits<1>  sign = signF32UI(v);
    Boolean  sub = (v[30:23] == 0);

    # Initialize to normal-path values; clz always computed but only applied if sub
    Bits<8>  nr_leadingzeros = count_leading_zeros(32, sig) - 9;
    Bits<32> normalized_exp = exp;
    Bits<32> normalized_sig = sig;

    if (sub) {
      normalized_exp = -(nr_leadingzeros `+ 0);
      normalized_sig = sig << (1 + nr_leadingzeros);
    }

    # Table index: top 7 bits of normalized_sig[22:16]
    Bits<7> idx = normalized_sig[22:16];
    U32 tidx = idx;

    # Output exponent: 2*(2^(8-1)-1) - 1 - normalized_exp = 2*127-1-exp = 253-exp
    Bits<16> nexp16 = normalized_exp[15:0];
    Bits<16> mid_exp16 = 16'h00FD - nexp16;
    Bits<8> mid_exp = mid_exp16[7:0];

    Bits<32> mid_sig = {9'b0, vfrec7_table[tidx][6:0], 16'b0};

    # Handle overflow/underflow exponent cases (Sail: if mid_exp==0 or mid_exp==all-ones)
    Bits<32> out_exp_bits;
    Bits<32> out_sig_bits;

    if (mid_exp == 0) {
      out_exp_bits = 0;
      out_sig_bits = (mid_sig >> 1) | 32'h00400000;
    } else if (mid_exp == 8'hFF) {
      out_exp_bits = 0;
      out_sig_bits = (mid_sig >> 2) | 32'h00200000;
    } else {
      out_exp_bits = {24'b0, mid_exp};
      out_sig_bits = mid_sig;
    }

    # Subnormal round_abnormal case: if sub && nr_leadingzeros > 1, set NX+OF
    if (sub && (nr_leadingzeros > 1)) {
      Bits<1> neg = (mode == RoundingMode::RDN && sign == 1) ? 1 : 0;
      neg = neg | ((mode == RoundingMode::RUP && sign == 0) ? 1 : 0);
      if (neg == 0) {
        set_fp_flag(FpFlag::NX);
        set_fp_flag(FpFlag::OF);
        return packToF32UI(sign, 8'hFE, 23'h7FFFFF);
      } else {
        set_fp_flag(FpFlag::NX);
        set_fp_flag(FpFlag::OF);
        return packToF32UI(sign, 8'hFF, 0);
      }
    }

    return packToF32UI(sign, out_exp_bits[7:0], out_sig_bits[22:0]);
  }
}

# 7-bit reciprocal-sqrt approximation for a single f64 element.
# Direct width-port of f32_rsqrt7 (same 128-entry table, per V spec §14.11 the table
# is precision-independent — only bias/width constants change for 'e=11, s=52).
function f64_rsqrt7 {
  returns Bits<64>
  arguments
    Bits<64> v,
    RoundingMode mode
  description {
    7-bit reciprocal-sqrt approximation per RISC-V V spec §14.11, f64 width.
    Used by vfrsqrt7.v at SEW=64. Ported from f32_rsqrt7 (see that function for the
    Sail derivation); constants here are for 'm=64, s=52, e=11.
  }
  body {
    if (is_dp_signaling_nan?(v)) {
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }
    if (is_dp_nan?(v)) {
      return DP_CANONICAL_NAN;
    }
    if (v == DP_NEG_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return DP_NEG_INF;
    }
    if (v == DP_POS_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return DP_POS_INF;
    }
    if (v == DP_POS_INF) {
      return DP_POS_ZERO;
    }
    if (signF64UI(v) == 1) {
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }

    # Inner rsqrt7 algorithm (Sail rsqrt7 for 'm=64, s=52, e=11)
    Bits<64> sig = {12'b0, v[51:0]};
    Bits<64> exp = {53'b0, v[62:52]};

    Boolean sub = (v[62:52] == 0);

    Bits<64> normalized_exp = exp;
    Bits<64> normalized_sig = sig;

    if (sub) {
      Bits<8> nr_leadingzeros = count_leading_zeros(64, sig) - 12;
      normalized_exp = -(nr_leadingzeros `+ 0);
      normalized_sig = sig << (1 + nr_leadingzeros);
    }

    # Table index: [normalized_exp[0]] @ normalized_sig[51:46] (top 6 mantissa bits)
    Bits<7> idx = {normalized_exp[0], normalized_sig[51:46]};
    U32 tidx = idx;
    # Place top 7 bits of table value at bits 51:45 of the 52-bit significand
    Bits<64> out_sig = {12'b0, vfrsqrt7_table[tidx][6:0], 45'b0};

    # Output exponent: (3*(2^(11-1)-1) - 1 - normalized_exp) / 2 = (3*1023-1-exp)/2 = (3068-exp)/2
    Bits<16> nexp16 = normalized_exp[15:0];
    Bits<16> out_exp16 = (16'h0BFC - nexp16) >> 1;
    Bits<11> out_exp = out_exp16[10:0];

    return {signF64UI(v), out_exp, out_sig[51:0]};
  }
}

# 7-bit reciprocal approximation for a single f64 element.
# Direct width-port of f32_rec7 (same 128-entry table; see f64_rsqrt7 for width-port rationale).
function f64_rec7 {
  returns Bits<64>
  arguments
    Bits<64> v,
    RoundingMode mode
  description {
    7-bit reciprocal approximation per RISC-V V spec §14.10, f64 width.
    Used by vfrec7.v at SEW=64. Ported from f32_rec7; constants here are for 'm=64, s=52, e=11.
  }
  body {
    if (is_dp_signaling_nan?(v)) {
      set_fp_flag(FpFlag::NV);
      return DP_CANONICAL_NAN;
    }
    if (is_dp_nan?(v)) {
      return DP_CANONICAL_NAN;
    }
    if (v == DP_NEG_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return DP_NEG_INF;
    }
    if (v == DP_POS_ZERO) {
      set_fp_flag(FpFlag::DZ);
      return DP_POS_INF;
    }
    if (v == DP_NEG_INF) {
      return DP_NEG_ZERO;
    }
    if (v == DP_POS_INF) {
      return DP_POS_ZERO;
    }

    # Inner recip7 algorithm (Sail recip7 for 'm=64, s=52, e=11)
    Bits<64> sig = {12'b0, v[51:0]};
    Bits<64> exp = {53'b0, v[62:52]};
    Bits<1>  sign = signF64UI(v);
    Boolean  sub = (v[62:52] == 0);

    Bits<8>  nr_leadingzeros = count_leading_zeros(64, sig) - 12;
    Bits<64> normalized_exp = exp;
    Bits<64> normalized_sig = sig;

    if (sub) {
      normalized_exp = -(nr_leadingzeros `+ 0);
      normalized_sig = sig << (1 + nr_leadingzeros);
    }

    # Table index: top 7 bits of normalized_sig[51:45]
    Bits<7> idx = normalized_sig[51:45];
    U32 tidx = idx;

    # Output exponent: 2*(2^(11-1)-1) - 1 - normalized_exp = 2*1023-1-exp = 2045-exp
    Bits<16> nexp16 = normalized_exp[15:0];
    Bits<16> mid_exp16 = 16'h07FD - nexp16;
    Bits<11> mid_exp = mid_exp16[10:0];

    Bits<64> mid_sig = {12'b0, vfrec7_table[tidx][6:0], 45'b0};

    # Handle overflow/underflow exponent cases (Sail: if mid_exp==0 or mid_exp==all-ones)
    Bits<64> out_exp_bits;
    Bits<64> out_sig_bits;

    if (mid_exp == 0) {
      out_exp_bits = 0;
      out_sig_bits = (mid_sig >> 1) | (64'b1 << 51);
    } else if (mid_exp == 11'h7FF) {
      out_exp_bits = 0;
      out_sig_bits = (mid_sig >> 2) | (64'b1 << 50);
    } else {
      out_exp_bits = {53'b0, mid_exp};
      out_sig_bits = mid_sig;
    }

    # Subnormal round_abnormal case: if sub && nr_leadingzeros > 1, set NX+OF
    if (sub && (nr_leadingzeros > 1)) {
      Bits<1> neg = (mode == RoundingMode::RDN && sign == 1) ? 1 : 0;
      neg = neg | ((mode == RoundingMode::RUP && sign == 0) ? 1 : 0);
      if (neg == 0) {
        set_fp_flag(FpFlag::NX);
        set_fp_flag(FpFlag::OF);
        return packToF64UI(sign, 11'h7FE, 52'hFFFFFFFFFFFFF);
      } else {
        set_fp_flag(FpFlag::NX);
        set_fp_flag(FpFlag::OF);
        return packToF64UI(sign, 11'h7FF, 0);
      }
    }

    return packToF64UI(sign, out_exp_bits[10:0], out_sig_bits[51:0]);
  }
}

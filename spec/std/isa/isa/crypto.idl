function crypto_sm4_sbox {
  returns Bits<8>
  arguments Bits<8> value
  description {
    Apply the SM4 S-box.
  }
  body {
    return crypto_sm4_sbox_table[value];
  }
}

function crypto_clmul64 {
  returns Bits<128>
  arguments
    Bits<64> multiplicand,
    Bits<64> multiplier
  description {
    Compute the complete 128-bit carry-less product of two 64-bit values.
  }
  body {
    Bits<128> product = 0;
    Bits<128> wide_multiplicand = multiplicand;

    for (U32 bit = 0; bit < 64; bit++) {
      if (multiplier[bit] == 1) {
        product = product ^ (wide_multiplicand << bit);
      }
    }

    return product;
  }
}

function crypto_brev8_128 {
  returns Bits<128>
  arguments Bits<128> value
  description {
    Reverse the bit order independently within every byte of a 128-bit value.
  }
  body {
    Bits<128> output = 0;

    for (U32 byte = 0; byte < 16; byte++) {
      U32 byte_bit = byte * 8;
      for (U32 bit = 0; bit < 8; bit++) {
        output[byte_bit + bit] = value[byte_bit + 7 - bit];
      }
    }

    return output;
  }
}

function crypto_gcm_gf_mul {
  returns Bits<128>
  arguments
    Bits<128> multiplicand,
    Bits<128> multiplier
  description {
    Multiply two binary field elements using the GCM reflected polynomial form.
  }
  body {
    Bits<128> result = 0;
    Bits<128> value = multiplicand;

    for (U32 bit = 0; bit < 128; bit++) {
      if (multiplier[bit] == 1) {
        result = result ^ value;
      }

      Bits<128> shifted = value << 1;
      value = value[127] == 1 ? shifted ^ 0x87 : shifted;
    }

    return result;
  }
}

function crypto_aes_rotword {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Rotate an AES key-schedule word left by one byte.
  }
  body {
    return {value[7:0], value[31:24], value[23:16], value[15:8]};
  }
}

function crypto_aes_subbytes_fwd128 {
  returns Bits<128>
  arguments Bits<128> value
  description {
    Apply the forward AES S-box to each byte of a 128-bit state.
  }
  body {
    return {
      crypto_aes_subword_fwd(value[127:96]),
      crypto_aes_subword_fwd(value[95:64]),
      crypto_aes_subword_fwd(value[63:32]),
      crypto_aes_subword_fwd(value[31:0])
    };
  }
}

function crypto_aes_subbytes_inv128 {
  returns Bits<128>
  arguments Bits<128> value
  description {
    Apply the inverse AES S-box to each byte of a 128-bit state.
  }
  body {
    return {
      crypto_aes_subword_inv(value[127:96]),
      crypto_aes_subword_inv(value[95:64]),
      crypto_aes_subword_inv(value[63:32]),
      crypto_aes_subword_inv(value[31:0])
    };
  }
}

function crypto_aes_shiftrows_fwd128 {
  returns Bits<128>
  arguments Bits<128> value
  description {
    Apply the forward AES ShiftRows transform to a 128-bit state.
  }
  body {
    Bits<32> w0 = value[31:0];
    Bits<32> w1 = value[63:32];
    Bits<32> w2 = value[95:64];
    Bits<32> w3 = value[127:96];

    Bits<32> r0 = {w3[31:24], w2[23:16], w1[15:8], w0[7:0]};
    Bits<32> r1 = {w0[31:24], w3[23:16], w2[15:8], w1[7:0]};
    Bits<32> r2 = {w1[31:24], w0[23:16], w3[15:8], w2[7:0]};
    Bits<32> r3 = {w2[31:24], w1[23:16], w0[15:8], w3[7:0]};
    return {r3, r2, r1, r0};
  }
}

function crypto_aes_shiftrows_inv128 {
  returns Bits<128>
  arguments Bits<128> value
  description {
    Apply the inverse AES ShiftRows transform to a 128-bit state.
  }
  body {
    Bits<32> w0 = value[31:0];
    Bits<32> w1 = value[63:32];
    Bits<32> w2 = value[95:64];
    Bits<32> w3 = value[127:96];

    Bits<32> r0 = {w1[31:24], w2[23:16], w3[15:8], w0[7:0]};
    Bits<32> r1 = {w2[31:24], w3[23:16], w0[15:8], w1[7:0]};
    Bits<32> r2 = {w3[31:24], w0[23:16], w1[15:8], w2[7:0]};
    Bits<32> r3 = {w0[31:24], w1[23:16], w2[15:8], w3[7:0]};
    return {r3, r2, r1, r0};
  }
}

function crypto_aes_mixcolumns_fwd128 {
  returns Bits<128>
  arguments Bits<128> value
  description {
    Apply the forward AES MixColumns transform to a 128-bit state.
  }
  body {
    return {
      crypto_aes_mixcolumn_fwd(value[127:96]),
      crypto_aes_mixcolumn_fwd(value[95:64]),
      crypto_aes_mixcolumn_fwd(value[63:32]),
      crypto_aes_mixcolumn_fwd(value[31:0])
    };
  }
}

function crypto_aes_mixcolumns_inv128 {
  returns Bits<128>
  arguments Bits<128> value
  description {
    Apply the inverse AES MixColumns transform to a 128-bit state.
  }
  body {
    return {
      crypto_aes_mixcolumn_inv(value[127:96]),
      crypto_aes_mixcolumn_inv(value[95:64]),
      crypto_aes_mixcolumn_inv(value[63:32]),
      crypto_aes_mixcolumn_inv(value[31:0])
    };
  }
}

function crypto_aes_enc_final128 {
  returns Bits<128>
  arguments
    Bits<128> state,
    Bits<128> round_key
  description {
    Perform an AES forward final round on a complete vector element group.
  }
  body {
    return crypto_aes_shiftrows_fwd128(crypto_aes_subbytes_fwd128(state)) ^ round_key;
  }
}

function crypto_aes_enc_middle128 {
  returns Bits<128>
  arguments
    Bits<128> state,
    Bits<128> round_key
  description {
    Perform an AES forward middle round on a complete vector element group.
  }
  body {
    return crypto_aes_mixcolumns_fwd128(
      crypto_aes_shiftrows_fwd128(crypto_aes_subbytes_fwd128(state))) ^ round_key;
  }
}

function crypto_aes_dec_final128 {
  returns Bits<128>
  arguments
    Bits<128> state,
    Bits<128> round_key
  description {
    Perform an AES inverse final round on a complete vector element group.
  }
  body {
    return crypto_aes_subbytes_inv128(crypto_aes_shiftrows_inv128(state)) ^ round_key;
  }
}

function crypto_aes_dec_middle128 {
  returns Bits<128>
  arguments
    Bits<128> state,
    Bits<128> round_key
  description {
    Perform an AES inverse middle round on a complete vector element group.
  }
  body {
    Bits<128> add_round_key = crypto_aes_dec_final128(state, round_key);
    return crypto_aes_mixcolumns_inv128(add_round_key);
  }
}

function crypto_aes_key_schedule_128 {
  returns Bits<128>
  arguments
    Bits<128> current,
    Bits<4> round
  description {
    Generate one AES-128 forward key-schedule element group.
  }
  body {
    Bits<32> w0 = current[31:0];
    Bits<32> w1 = current[63:32];
    Bits<32> w2 = current[95:64];
    Bits<32> w3 = current[127:96];
    Bits<4> rcon_round = round - 1;
    Bits<32> n0 = crypto_aes_subword_fwd(crypto_aes_rotword(w3)) ^
      crypto_aes_rcon(rcon_round) ^ w0;
    Bits<32> n1 = n0 ^ w1;
    Bits<32> n2 = n1 ^ w2;
    Bits<32> n3 = n2 ^ w3;
    return {n3, n2, n1, n0};
  }
}

function crypto_aes_key_schedule_256 {
  returns Bits<128>
  arguments
    Bits<128> current,
    Bits<128> previous,
    Bits<4> round
  description {
    Generate one AES-256 forward key-schedule element group.
  }
  body {
    Bits<32> c3 = current[127:96];
    Bits<32> p0 = previous[31:0];
    Bits<32> p1 = previous[63:32];
    Bits<32> p2 = previous[95:64];
    Bits<32> p3 = previous[127:96];
    Bits<32> n0;

    if (round[0] == 1) {
      n0 = crypto_aes_subword_fwd(c3) ^ p0;
    } else {
      Bits<4> rcon_round = (round >> 1) - 1;
      n0 = crypto_aes_subword_fwd(crypto_aes_rotword(c3)) ^ crypto_aes_rcon(rcon_round) ^ p0;
    }

    Bits<32> n1 = n0 ^ p1;
    Bits<32> n2 = n1 ^ p2;
    Bits<32> n3 = n2 ^ p3;
    return {n3, n2, n1, n0};
  }
}

function crypto_sha256_sig0 {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Compute the SHA-256 small sigma zero function.
  }
  body {
    return crypto_ror32(value, 7) ^ crypto_ror32(value, 18) ^ (value >> 3);
  }
}

function crypto_sha256_sig1 {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Compute the SHA-256 small sigma one function.
  }
  body {
    return crypto_ror32(value, 17) ^ crypto_ror32(value, 19) ^ (value >> 10);
  }
}

function crypto_sha256_sum0 {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Compute the SHA-256 big sigma zero function.
  }
  body {
    return crypto_ror32(value, 2) ^ crypto_ror32(value, 13) ^ crypto_ror32(value, 22);
  }
}

function crypto_sha256_sum1 {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Compute the SHA-256 big sigma one function.
  }
  body {
    return crypto_ror32(value, 6) ^ crypto_ror32(value, 11) ^ crypto_ror32(value, 25);
  }
}

function crypto_sha512_sig0 {
  returns Bits<64>
  arguments Bits<64> value
  description {
    Compute the SHA-512 small sigma zero function.
  }
  body {
    return crypto_ror64(value, 1) ^ crypto_ror64(value, 8) ^ (value >> 7);
  }
}

function crypto_sha512_sig1 {
  returns Bits<64>
  arguments Bits<64> value
  description {
    Compute the SHA-512 small sigma one function.
  }
  body {
    return crypto_ror64(value, 19) ^ crypto_ror64(value, 61) ^ (value >> 6);
  }
}

function crypto_sha512_sum0 {
  returns Bits<64>
  arguments Bits<64> value
  description {
    Compute the SHA-512 big sigma zero function.
  }
  body {
    return crypto_ror64(value, 28) ^ crypto_ror64(value, 34) ^ crypto_ror64(value, 39);
  }
}

function crypto_sha512_sum1 {
  returns Bits<64>
  arguments Bits<64> value
  description {
    Compute the SHA-512 big sigma one function.
  }
  body {
    return crypto_ror64(value, 14) ^ crypto_ror64(value, 18) ^ crypto_ror64(value, 41);
  }
}

function crypto_sha256_schedule {
  returns Bits<128>
  arguments
    Bits<128> destination,
    Bits<128> source2,
    Bits<128> source1
  description {
    Generate four SHA-256 message-schedule words.
  }
  body {
    Bits<32> w0 = destination[31:0];
    Bits<32> w1 = destination[63:32];
    Bits<32> w2 = destination[95:64];
    Bits<32> w3 = destination[127:96];
    Bits<32> w4 = source2[31:0];
    Bits<32> w9 = source2[63:32];
    Bits<32> w10 = source2[95:64];
    Bits<32> w11 = source2[127:96];
    Bits<32> w12 = source1[31:0];
    Bits<32> w13 = source1[63:32];
    Bits<32> w14 = source1[95:64];
    Bits<32> w15 = source1[127:96];

    Bits<32> w16 = crypto_sha256_sig1(w14) + w9 + crypto_sha256_sig0(w1) + w0;
    Bits<32> w17 = crypto_sha256_sig1(w15) + w10 + crypto_sha256_sig0(w2) + w1;
    Bits<32> w18 = crypto_sha256_sig1(w16) + w11 + crypto_sha256_sig0(w3) + w2;
    Bits<32> w19 = crypto_sha256_sig1(w17) + w12 + crypto_sha256_sig0(w4) + w3;
    return {w19, w18, w17, w16};
  }
}

function crypto_sha512_schedule {
  returns Bits<256>
  arguments
    Bits<256> destination,
    Bits<256> source2,
    Bits<256> source1
  description {
    Generate four SHA-512 message-schedule words.
  }
  body {
    Bits<64> w0 = destination[63:0];
    Bits<64> w1 = destination[127:64];
    Bits<64> w2 = destination[191:128];
    Bits<64> w3 = destination[255:192];
    Bits<64> w4 = source2[63:0];
    Bits<64> w9 = source2[127:64];
    Bits<64> w10 = source2[191:128];
    Bits<64> w11 = source2[255:192];
    Bits<64> w12 = source1[63:0];
    Bits<64> w13 = source1[127:64];
    Bits<64> w14 = source1[191:128];
    Bits<64> w15 = source1[255:192];

    Bits<64> w16 = crypto_sha512_sig1(w14) + w9 + crypto_sha512_sig0(w1) + w0;
    Bits<64> w17 = crypto_sha512_sig1(w15) + w10 + crypto_sha512_sig0(w2) + w1;
    Bits<64> w18 = crypto_sha512_sig1(w16) + w11 + crypto_sha512_sig0(w3) + w2;
    Bits<64> w19 = crypto_sha512_sig1(w17) + w12 + crypto_sha512_sig0(w4) + w3;
    return {w19, w18, w17, w16};
  }
}

function crypto_sha256_compress {
  returns Bits<128>
  arguments
    Bits<128> state_abef,
    Bits<128> state_cdgh,
    Bits<128> message,
    Boolean high_half
  description {
    Perform two SHA-256 compression rounds and return the next working state subset.
  }
  body {
    Bits<32> a = state_abef[127:96];
    Bits<32> b = state_abef[95:64];
    Bits<32> e = state_abef[63:32];
    Bits<32> f = state_abef[31:0];
    Bits<32> c = state_cdgh[127:96];
    Bits<32> d = state_cdgh[95:64];
    Bits<32> g = state_cdgh[63:32];
    Bits<32> h = state_cdgh[31:0];
    Bits<32> w0 = high_half ? message[95:64] : message[31:0];
    Bits<32> w1 = high_half ? message[127:96] : message[63:32];

    Bits<32> t1 = h + crypto_sha256_sum1(e) + ((e & f) ^ ((~e) & g)) + w0;
    Bits<32> t2 = crypto_sha256_sum0(a) + ((a & b) ^ (a & c) ^ (b & c));
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;

    t1 = h + crypto_sha256_sum1(e) + ((e & f) ^ ((~e) & g)) + w1;
    t2 = crypto_sha256_sum0(a) + ((a & b) ^ (a & c) ^ (b & c));
    h = g;
    g = f;
    f = e;
    e = d + t1;
    b = a;
    a = t1 + t2;

    return {a, b, e, f};
  }
}

function crypto_sha512_compress {
  returns Bits<256>
  arguments
    Bits<256> state_abef,
    Bits<256> state_cdgh,
    Bits<256> message,
    Boolean high_half
  description {
    Perform two SHA-512 compression rounds and return the next working state subset.
  }
  body {
    Bits<64> a = state_abef[255:192];
    Bits<64> b = state_abef[191:128];
    Bits<64> e = state_abef[127:64];
    Bits<64> f = state_abef[63:0];
    Bits<64> c = state_cdgh[255:192];
    Bits<64> d = state_cdgh[191:128];
    Bits<64> g = state_cdgh[127:64];
    Bits<64> h = state_cdgh[63:0];
    Bits<64> w0 = high_half ? message[191:128] : message[63:0];
    Bits<64> w1 = high_half ? message[255:192] : message[127:64];

    Bits<64> t1 = h + crypto_sha512_sum1(e) + ((e & f) ^ ((~e) & g)) + w0;
    Bits<64> t2 = crypto_sha512_sum0(a) + ((a & b) ^ (a & c) ^ (b & c));
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;

    t1 = h + crypto_sha512_sum1(e) + ((e & f) ^ ((~e) & g)) + w1;
    t2 = crypto_sha512_sum0(a) + ((a & b) ^ (a & c) ^ (b & c));
    h = g;
    g = f;
    f = e;
    e = d + t1;
    b = a;
    a = t1 + t2;

    return {a, b, e, f};
  }
}

function crypto_rev8_32 {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Reverse the byte order of a 32-bit word.
  }
  body {
    return {value[7:0], value[15:8], value[23:16], value[31:24]};
  }
}

function crypto_sm3_p0 {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Apply the SM3 P0 permutation.
  }
  body {
    return value ^ crypto_rol32(value, 9) ^ crypto_rol32(value, 17);
  }
}

function crypto_sm3_p1 {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Apply the SM3 P1 permutation.
  }
  body {
    return value ^ crypto_rol32(value, 15) ^ crypto_rol32(value, 23);
  }
}

function crypto_sm3_compress {
  returns Bits<256>
  arguments
    Bits<256> state,
    Bits<256> message,
    Bits<5> round_group
  description {
    Perform two SM3 compression rounds on one 256-bit element group.
  }
  body {
    Bits<32> a = crypto_rev8_32(state[31:0]);
    Bits<32> b = crypto_rev8_32(state[63:32]);
    Bits<32> c = crypto_rev8_32(state[95:64]);
    Bits<32> d = crypto_rev8_32(state[127:96]);
    Bits<32> e = crypto_rev8_32(state[159:128]);
    Bits<32> f = crypto_rev8_32(state[191:160]);
    Bits<32> g = crypto_rev8_32(state[223:192]);
    Bits<32> h = crypto_rev8_32(state[255:224]);
    Bits<32> w0 = crypto_rev8_32(message[31:0]);
    Bits<32> w1 = crypto_rev8_32(message[63:32]);
    Bits<32> w4 = crypto_rev8_32(message[159:128]);
    Bits<32> w5 = crypto_rev8_32(message[191:160]);
    Bits<32> x0 = w0 ^ w4;
    Bits<32> x1 = w1 ^ w5;
    U32 j = round_group * 2;

    Bits<32> t = j <= 15 ? 0x79cc4519 : 0x7a879d8a;
    Bits<32> ss1 = crypto_rol32(crypto_rol32(a, 12) + e + crypto_rol32(t, j % 32), 7);
    Bits<32> ss2 = ss1 ^ crypto_rol32(a, 12);
    Bits<32> ff = j <= 15 ? a ^ b ^ c : (a & b) | (a & c) | (b & c);
    Bits<32> gg = j <= 15 ? e ^ f ^ g : (e & f) | ((~e) & g);
    Bits<32> tt1 = ff + d + ss2 + x0;
    Bits<32> tt2 = gg + h + ss1 + w0;
    Bits<32> c1 = crypto_rol32(b, 9);
    Bits<32> a1 = tt1;
    Bits<32> g1 = crypto_rol32(f, 19);
    Bits<32> e1 = crypto_sm3_p0(tt2);

    j = j + 1;
    t = j <= 15 ? 0x79cc4519 : 0x7a879d8a;
    ss1 = crypto_rol32(crypto_rol32(a1, 12) + e1 + crypto_rol32(t, j % 32), 7);
    ss2 = ss1 ^ crypto_rol32(a1, 12);
    ff = j <= 15 ? a1 ^ a ^ c1 : (a1 & a) | (a1 & c1) | (a & c1);
    gg = j <= 15 ? e1 ^ e ^ g1 : (e1 & e) | ((~e1) & g1);
    tt1 = ff + c + ss2 + x1;
    tt2 = gg + g + ss1 + w1;
    Bits<32> c2 = crypto_rol32(a, 9);
    Bits<32> a2 = tt1;
    Bits<32> g2 = crypto_rol32(e, 19);
    Bits<32> e2 = crypto_sm3_p0(tt2);

    return {
      crypto_rev8_32(g1), crypto_rev8_32(g2),
      crypto_rev8_32(e1), crypto_rev8_32(e2),
      crypto_rev8_32(c1), crypto_rev8_32(c2),
      crypto_rev8_32(a1), crypto_rev8_32(a2)
    };
  }
}

function crypto_sm3_expand {
  returns Bits<256>
  arguments
    Bits<256> source2,
    Bits<256> source1
  description {
    Generate eight SM3 message-schedule words from two element groups.
  }
  body {
    Bits<32> w0 = crypto_rev8_32(source1[31:0]);
    Bits<32> w1 = crypto_rev8_32(source1[63:32]);
    Bits<32> w2 = crypto_rev8_32(source1[95:64]);
    Bits<32> w3 = crypto_rev8_32(source1[127:96]);
    Bits<32> w4 = crypto_rev8_32(source1[159:128]);
    Bits<32> w5 = crypto_rev8_32(source1[191:160]);
    Bits<32> w6 = crypto_rev8_32(source1[223:192]);
    Bits<32> w7 = crypto_rev8_32(source1[255:224]);
    Bits<32> w8 = crypto_rev8_32(source2[31:0]);
    Bits<32> w9 = crypto_rev8_32(source2[63:32]);
    Bits<32> w10 = crypto_rev8_32(source2[95:64]);
    Bits<32> w11 = crypto_rev8_32(source2[127:96]);
    Bits<32> w12 = crypto_rev8_32(source2[159:128]);
    Bits<32> w13 = crypto_rev8_32(source2[191:160]);
    Bits<32> w14 = crypto_rev8_32(source2[223:192]);
    Bits<32> w15 = crypto_rev8_32(source2[255:224]);

    Bits<32> w16 = crypto_sm3_p1(w0 ^ w7 ^ crypto_rol32(w13, 15)) ^ crypto_rol32(w3, 7) ^ w10;
    Bits<32> w17 = crypto_sm3_p1(w1 ^ w8 ^ crypto_rol32(w14, 15)) ^ crypto_rol32(w4, 7) ^ w11;
    Bits<32> w18 = crypto_sm3_p1(w2 ^ w9 ^ crypto_rol32(w15, 15)) ^ crypto_rol32(w5, 7) ^ w12;
    Bits<32> w19 = crypto_sm3_p1(w3 ^ w10 ^ crypto_rol32(w16, 15)) ^ crypto_rol32(w6, 7) ^ w13;
    Bits<32> w20 = crypto_sm3_p1(w4 ^ w11 ^ crypto_rol32(w17, 15)) ^ crypto_rol32(w7, 7) ^ w14;
    Bits<32> w21 = crypto_sm3_p1(w5 ^ w12 ^ crypto_rol32(w18, 15)) ^ crypto_rol32(w8, 7) ^ w15;
    Bits<32> w22 = crypto_sm3_p1(w6 ^ w13 ^ crypto_rol32(w19, 15)) ^ crypto_rol32(w9, 7) ^ w16;
    Bits<32> w23 = crypto_sm3_p1(w7 ^ w14 ^ crypto_rol32(w20, 15)) ^ crypto_rol32(w10, 7) ^ w17;

    return {
      crypto_rev8_32(w23), crypto_rev8_32(w22),
      crypto_rev8_32(w21), crypto_rev8_32(w20),
      crypto_rev8_32(w19), crypto_rev8_32(w18),
      crypto_rev8_32(w17), crypto_rev8_32(w16)
    };
  }
}

Bits<32> crypto_sm4_ck_table[32] = [
  0x00070e15, 0x1c232a31, 0x383f464d, 0x545b6269,
  0x70777e85, 0x8c939aa1, 0xa8afb6bd, 0xc4cbd2d9,
  0xe0e7eef5, 0xfc030a11, 0x181f262d, 0x343b4249,
  0x50575e65, 0x686f767d, 0x848b9299, 0xa0a7aeb5,
  0xc0c7ced5, 0xdce3eaf1, 0xf8ff060d, 0x141b2229,
  0x30373e45, 0x4c535a61, 0x686f767d, 0x848b9299,
  0xa0a7aeb5, 0xbcc3cad1, 0xd8dfe6ed, 0xf4fb0209,
  0x10171e25, 0x2c333a41, 0x484f565d, 0x646b7279
];

function crypto_sm4_subword {
  returns Bits<32>
  arguments Bits<32> value
  description {
    Apply the SM4 S-box to each byte of a word.
  }
  body {
    return {
      crypto_sm4_sbox(value[31:24]),
      crypto_sm4_sbox(value[23:16]),
      crypto_sm4_sbox(value[15:8]),
      crypto_sm4_sbox(value[7:0])
    };
  }
}

function crypto_sm4_round_word {
  returns Bits<32>
  arguments
    Bits<32> state_word,
    Bits<32> substitution
  description {
    Apply the SM4 data-round linear transform and XOR it with a state word.
  }
  body {
    return state_word ^ substitution ^ crypto_rol32(substitution, 2) ^
      crypto_rol32(substitution, 10) ^ crypto_rol32(substitution, 18) ^
      crypto_rol32(substitution, 24);
  }
}

function crypto_sm4_key_round_word {
  returns Bits<32>
  arguments
    Bits<32> key_word,
    Bits<32> substitution
  description {
    Apply the SM4 key-schedule linear transform and XOR it with a key word.
  }
  body {
    return key_word ^ substitution ^ crypto_rol32(substitution, 13) ^
      crypto_rol32(substitution, 23);
  }
}

function crypto_sm4_key_schedule {
  returns Bits<128>
  arguments
    Bits<128> current,
    Bits<3> round
  description {
    Generate four SM4 round keys from one input element group.
  }
  body {
    Bits<32> rk0 = current[31:0];
    Bits<32> rk1 = current[63:32];
    Bits<32> rk2 = current[95:64];
    Bits<32> rk3 = current[127:96];
    U32 base = round * 4;
    Bits<32> rk4 = crypto_sm4_key_round_word(rk0,
      crypto_sm4_subword(rk1 ^ rk2 ^ rk3 ^ crypto_sm4_ck_table[base]));
    Bits<32> rk5 = crypto_sm4_key_round_word(rk1,
      crypto_sm4_subword(rk2 ^ rk3 ^ rk4 ^ crypto_sm4_ck_table[base + 1]));
    Bits<32> rk6 = crypto_sm4_key_round_word(rk2,
      crypto_sm4_subword(rk3 ^ rk4 ^ rk5 ^ crypto_sm4_ck_table[base + 2]));
    Bits<32> rk7 = crypto_sm4_key_round_word(rk3,
      crypto_sm4_subword(rk4 ^ rk5 ^ rk6 ^ crypto_sm4_ck_table[base + 3]));
    return {rk7, rk6, rk5, rk4};
  }
}

function crypto_sm4_rounds {
  returns Bits<128>
  arguments
    Bits<128> state,
    Bits<128> round_keys
  description {
    Perform four SM4 encryption or decryption rounds on one element group.
  }
  body {
    Bits<32> x0 = state[31:0];
    Bits<32> x1 = state[63:32];
    Bits<32> x2 = state[95:64];
    Bits<32> x3 = state[127:96];
    Bits<32> rk0 = round_keys[31:0];
    Bits<32> rk1 = round_keys[63:32];
    Bits<32> rk2 = round_keys[95:64];
    Bits<32> rk3 = round_keys[127:96];
    Bits<32> x4 = crypto_sm4_round_word(x0, crypto_sm4_subword(x1 ^ x2 ^ x3 ^ rk0));
    Bits<32> x5 = crypto_sm4_round_word(x1, crypto_sm4_subword(x2 ^ x3 ^ x4 ^ rk1));
    Bits<32> x6 = crypto_sm4_round_word(x2, crypto_sm4_subword(x3 ^ x4 ^ x5 ^ rk2));
    Bits<32> x7 = crypto_sm4_round_word(x3, crypto_sm4_subword(x4 ^ x5 ^ x6 ^ rk3));
    return {x7, x6, x5, x4};
  }
}
